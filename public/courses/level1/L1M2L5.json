on-details strong{color:#2c3e50}.pairing-section{display:grid;grid-template-columns:1fr 1fr;gap:25px}.pairing-group{background:#fff;padding:25px;border-radius:12px;box-shadow:0 4px 15px rgba(0,0,0,.1)}.pairing-group h4{margin:0 0 15px;color:#34495e;font-size:1.2rem;border-bottom:3px solid #bdc3c7;padding-bottom:10px}.pairing-items{display:grid;gap:12px}.pairing-item{padding:12px 15px;background:linear-gradient(90deg,#ecf0f1,transparent);border-left:4px solid #95a5a6;color:#2c3e50;line-height:1.6}.buying-tips{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.tip-card{padding:25px;border-radius:12px;border-top:5px solid}.tip-card.beginner{background:linear-gradient(145deg,#e8f5e9,#fff);border-color:#4caf50}.tip-card.intermediate{background:linear-gradient(145deg,#fff3e0,#fff);border-color:#ff9800}.tip-card.premium{background:linear-gradient(145deg,#f3e5f5,#fff);border-color:#9c27b0}.tip-card h4{margin:0 0 15px;color:#2c3e50}.tip-card ul{margin:10px 0;padding-left:20px;line-height:2}.tip-note{margin-top:15px;padding-top:15px;border-top:2px solid rgba(0,0,0,.1);font-style:italic;color:#555;font-weight:600}.key-points{display:grid;gap:10px}.point{background:linear-gradient(90deg,#ecf0f1,transparent);padding:16px 22px;border-left:4px solid #95a5a6;font-size:1.05rem;font-weight:600;color:#2c3e50}</style><style>.map-slide-container{display:grid;grid-template-columns:2fr 1fr;gap:30px;height:calc(100vh - 200px);min-height:500px;padding:20px}.lombardy-region-map{width:100%;height:100%;border-radius:12px;overflow:hidden;box-shadow:0 8px 30px rgba(0,0,0,.3);background:#1a1a2e}.map-legend{background:rgba(26,26,46,.92);backdrop-filter:blur(10px);border-radius:12px;padding:25px;border:1px solid rgba(255,255,255,.2);height:fit-content;box-shadow:0 4px 20px rgba(0,0,0,.3)}</style></div><div style='display:flex;align-items:center;gap:12px'><div style='width:30px;height:20px;background:#3498db;border-radius:4px;flex-shrink:0;box-shadow:0 0 10px rgba(52,152,219,0.5)'></div><span style='color:rgba(255,255,255,0.95);font-size:1.05rem;font-weight:500'>B級 - Lugana DOC</span></div><div style='display:flex;align-items:center;gap:12px'><div style='width:30px;height:20px;background:#5dade2;border-radius:4px;flex-shrink:0;box-shadow:0 0 10px rgba(93,173,226,0.5)'></div><span style='color:rgba(255,255,255,0.95);font-size:1.05rem;font-weight:500'>B級 - Sforzato di Valtellina</span></div><div style='display:flex;align-items:center;gap:12px'><div style='width:30px;height:20px;background:#85c1e9;border-radius:4px;flex-shrink:0;box-shadow:0 0 10px rgba(133,193,233,0.5)'></div><span style='color:rgba(255,255,255,0.95);font-size:1.05rem;font-weight:500'>B級 - Valtellina Rosso",
  "quiz": [
    {
      "question": "Franciacorta DOCG 採用什麼釀造法？",
      "options": [
        "Charmat 法（罐中發酵）",
        "Metodo Classico（傳統香檳法）",
        "Asti 法",
        "Ancestrale 法"
      ],
      "answer": 1,
      "explanation": "Franciacorta 採用與香檳相同的傳統釀造法（Metodo Classico），瓶中二次發酵。"
    },
    {
      "question": "Franciacorta Satèn 的特色是？",
      "options": [
        "加入紅葡萄",
        "氣壓較低、口感絲滑",
        "陳年 60 個月",
        "甜型氣泡酒"
      ],
      "answer": 1,
      "explanation": "Satèn 是 Franciacorta 獨有的風格，僅用白葡萄，氣壓較低，口感更加細緻絲滑。"
    },
    {
      "question": "Franciacorta Riserva 至少需要陳年多久？",
      "options": [
        "18 個月",
        "24 個月",
        "30 個月",
        "60 個月"
      ],
      "answer": 3,
      "explanation": "Franciacorta Riserva 需要至少 60 個月（5 年）的陳年，是最高等級的 Franciacorta。"
    },
    {
      "question": "Valtellina 產區主要使用哪個葡萄品種？",
      "options": [
        "Sangiovese",
        "Nebbiolo",
        "Barbera",
        "Corvina"
      ],
      "answer": 1,
      "explanation": "Valtellina 使用 Nebbiolo 葡萄（當地稱為 Chiavennasca）釀造優雅的紅酒。"
    }
  ]
}
