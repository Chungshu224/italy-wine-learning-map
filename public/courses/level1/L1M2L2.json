{
  "lessonId": "L1M2L2",
  "title": "Tuscany 托斯卡納 - 經典之美",
  "content": "<div class='slides'><section class='slide-cover' style='background:linear-gradient(135deg,#c0392b 0%,#e74c3c 100%)'><h1>🌿 Toscana 托斯卡納</h1><p class='subtitle'>經典義式風情的代名詞</p></section><section class='slide tuscany-map-slide' style='padding:0'><div class='tuscany-map-container' style='display:grid;grid-template-columns:2fr 1fr;gap:20px;height:100%;padding:20px;background:#1a1a2e;border-radius:12px'><div id='tuscany-map' class='tuscany-region-map' style='border-radius:12px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,.3)'></div><div class='map-legend'><h3 style='margin:0 0 20px;color:#c0392b;font-size:1.3rem;text-align:center'>🌿 Tuscany 產區地圖</h3><div style='margin-bottom:25px;padding:15px;background:rgba(192,57,43,.15);border-radius:8px;border-left:4px solid #c0392b'><p style='margin:0;color:#ecf0f1;line-height:1.7;font-size:.95rem'>Sangiovese之鄉，經典義式風情代名詞</p></div><div style='margin-bottom:20px'><h4 style='margin:0 0 12px;color:#d4af37;font-size:1.1rem;border-bottom:2px solid #d4af37;padding-bottom:8px'>🏆 S級 DOCG</h4><div style='margin:8px 0;padding:10px;background:rgba(212,175,55,.1);border-radius:6px;border-left:3px solid #d4af37'><div style='display:flex;align-items:center;margin-bottom:5px'><div style='width:16px;height:16px;background:#d4af37;border-radius:3px;margin-right:10px'></div><strong style='color:#d4af37'>Brunello di Montalcino</strong></div><p style='margin:5px 0 0 26px;color:#bdc3c7;font-size:.88rem;line-height:1.6'>100% Sangiovese，5年陳年</p></div><div style='margin:8px 0;padding:10px;background:rgba(192,57,43,.1);border-radius:6px;border-left:3px solid #c0392b'><div style='display:flex;align-items:center;margin-bottom:5px'><div style='width:16px;height:16px;background:#c0392b;border-radius:3px;margin-right:10px'></div><strong style='color:#c0392b'>Chianti Classico</strong></div><p style='margin:5px 0 0 26px;color:#bdc3c7;font-size:.88rem;line-height:1.6'>黑公雞標誌，最經典</p></div></div><div style='margin-bottom:20px'><h4 style='margin:0 0 12px;color:#27ae60;font-size:1.1rem;border-bottom:2px solid #27ae60;padding-bottom:8px'>⭐ A級 DOCG</h4><div style='margin:8px 0;padding:10px;background:rgba(39,174,96,.1);border-radius:6px;border-left:3px solid #27ae60'><div style='display:flex;align-items:center;margin-bottom:5px'><div style='width:16px;height:16px;background:#27ae60;border-radius:3px;margin-right:10px'></div><strong style='color:#27ae60'>Chianti DOCG</strong></div><p style='margin:5px 0 0 26px;color:#bdc3c7;font-size:.88rem;line-height:1.6'>親民價格，日常餐酒</p></div><div style='margin:8px 0;padding:10px;background:rgba(230,126,34,.1);border-radius:6px;border-left:3px solid #e67e22'><div style='display:flex;align-items:center;margin-bottom:5px'><div style='width:16px;height:16px;background:#e67e22;border-radius:3px;margin-right:10px'></div><strong style='color:#e67e22'>Vino Nobile di Montepulciano</strong></div><p style='margin:5px 0 0 26px;color:#bdc3c7;font-size:.88rem;line-height:1.6'>介於Chianti與Brunello之間</p></div></div><div style='margin-bottom:20px'><h4 style='margin:0 0 12px;color:#3498db;font-size:1.1rem;border-bottom:2px solid #3498db;padding-bottom:8px'>💎 B級產區</h4><div style='margin:8px 0;padding:10px;background:rgba(52,152,219,.1);border-radius:6px;border-left:3px solid #3498db'><div style='display:flex;align-items:center;margin-bottom:5px'><div style='width:16px;height:16px;background:#3498db;border-radius:3px;margin-right:10px'></div><strong style='color:#3498db'>Vernaccia, Morellino di Scansano</strong></div><p style='margin:5px 0 0 26px;color:#bdc3c7;font-size:.88rem;line-height:1.6'>白酒與海岸紅酒</p></div></div></div></div></section><section class='slide'><h2>�📍 產區概況</h2><div class='region-overview'><div class='overview-item'><div class='overview-label'>位置</div><div class='overview-value'>義大利中部，亞平寧山脈</div></div><div class='overview-item'><div class='overview-label'>首府</div><div class='overview-value'>Firenze 佛羅倫斯</div></div><div class='overview-item'><div class='overview-label'>葡萄園面積</div><div class='overview-value'>~63,000 公頃</div></div><div class='overview-item'><div class='overview-label'>DOCG 數量</div><div class='overview-value'>11 個</div></div><div class='overview-item'><div class='overview-label'>主要品種</div><div class='overview-value'>Sangiovese (90%)</div></div><div class='overview-item'><div class='overview-label'>氣候</div><div class='overview-value'>地中海氣候，溫暖乾燥</div></div></div></section><section class='slide'><h2>🍇 Sangiovese - 托斯卡納之魂</h2><div class='grape-profile'><div class='grape-header'><div class='grape-icon'>🍷</div><h3>Sangiovese</h3><p>義大利種植面積最大的品種</p></div><div class='grape-characteristics'><div class='characteristic'><strong>顏色</strong><br>寶石紅，邊緣略帶橙色</div><div class='characteristic'><strong>香氣</strong><br>櫻桃、李子、紫羅蘭、茶葉</div><div class='characteristic'><strong>口感</strong><br>高酸、中高單寧、中等酒體</div><div class='characteristic'><strong>陳年</strong><br>5-20 年（視等級而定）</div></div></div></section><section class='slide'><h2>⭐ 五大必學 DOCG</h2><div class='docg-list'><div class='docg-card featured'><div class='docg-rank'>#1</div><div class='docg-content'><h3>Brunello di Montalcino DOCG</h3><p class='docg-grape'>100% Sangiovese (Brunello)</p><p class='docg-aging'>⏱️ 最低陳年：5年（2年橡木桶）</p><p class='docg-style'>🎯 風格：強勁、複雜、陳年潛力極強</p><p class='docg-price'>💰 價格：$$$$</p></div></div><div class='docg-card'><div class='docg-rank'>#2</div><div class='docg-content'><h3>Chianti Classico DOCG</h3><p class='docg-grape'>80-100% Sangiovese</p><p class='docg-aging'>⏱️ 陳年：Riserva 至少 24個月</p><p class='docg-style'>🎯 風格：酸度活潑、櫻桃風味、黑公雞標誌</p><p class='docg-price'>💰 價格：$$-$$$</p></div></div><div class='docg-card'><div class='docg-rank'>#3</div><div class='docg-content'><h3>Vino Nobile di Montepulciano</h3><p class='docg-grape'>70% Sangiovese (Prugnolo Gentile)</p><p class='docg-aging'>⏱️ 陳年：Riserva 至少 3年</p><p class='docg-style'>🎯 風格：介於 Chianti 和 Brunello 之間</p><p class='docg-price'>💰 價格：$$-$$$</p></div></div></div></section><section class='slide'><h2>🌟 超級托斯卡納</h2><div class='super-tuscan'><div class='super-tuscan-intro'><h3>打破傳統的革命</h3><p>1970年代，酒莊開始使用國際品種（Cabernet Sauvignon, Merlot）混釀或單釀，創造出高品質但只能標示為 IGT 的葡萄酒</p></div><div class='super-tuscan-examples'><div class='example-wine'><div class='wine-name'>Sassicaia</div><div class='wine-blend'>Cabernet Sauvignon + Cabernet Franc</div><div class='wine-status'>第一款超級托斯卡納 (1968)</div></div><div class='example-wine'><div class='wine-name'>Tignanello</div><div class='wine-blend'>Sangiovese + Cabernet</div><div class='wine-status'>Antinori 經典之作</div></div><div class='example-wine'><div class='wine-name'>Ornellaia</div><div class='wine-blend'>Bordeaux 品種混釀</div><div class='wine-status'>國際級頂尖酒款</div></div></div></div></section><section class='slide'><h2>🍽️ 餐酒搭配</h2><div class='pairing-grid'><div class='pairing-card'><div class='food-icon'>🥩</div><h4>Bistecca alla Fiorentina</h4><p>佛羅倫斯 T骨牛排</p><p class='pairing-wine'>→ Chianti Classico Riserva</p></div><div class='pairing-card'><div class='food-icon'>🍝</div><h4>野豬肉醬義大利麵</h4><p>Pappardelle al Cinghiale</p><p class='pairing-wine'>→ Brunello di Montalcino</p></div><div class='pairing-card'><div class='food-icon'>🧀</div><h4>Pecorino 羊奶起司</h4><p>托斯卡納特產</p><p class='pairing-wine'>→ Vino Nobile</p></div></div></section><section class='slide'><h2>🎓 重點回顧</h2><div class='summary-points'><div class='point-item'>✓ Sangiovese 是托斯卡納的靈魂品種</div><div class='point-item'>✓ Brunello = 最強勁，Chianti Classico = 最經典</div><div class='point-item'>✓ 超級托斯卡納打破傳統創造新風格</div><div class='point-item'>✓ 高酸度使其成為餐酒搭配之王</div></div></section></div><style>.region-overview{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;margin:20px 0}.overview-item{background:linear-gradient(135deg,#f8f9fa,#e9ecef);padding:18px;border-radius:10px;text-align:center;border-top:3px solid #c0392b}.overview-label{font-size:.9rem;color:#7f8c8d;margin-bottom:5px}.overview-value{font-size:1.15rem;font-weight:700;color:#2c3e50}.grape-profile{background:#f8f9fa;padding:30px;border-radius:12px}.grape-header{text-align:center;margin-bottom:25px;padding-bottom:20px;border-bottom:2px solid #e0e0e0}.grape-icon{font-size:3.5rem}.grape-profile h3{font-size:2rem;color:#c0392b;margin:10px 0 5px}.grape-characteristics{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.characteristic{background:#fff;padding:20px;border-radius:10px;text-align:center;border-top:3px solid #c0392b}.characteristic strong{display:block;color:#2c3e50;margin-bottom:8px;font-size:1.05rem}.docg-list{display:grid;gap:20px}.docg-card{background:#fff;padding:25px;border-radius:12px;border-left:5px solid #c0392b;display:flex;gap:20px;align-items:start;box-shadow:0 2px 8px rgba(0,0,0,.08)}.docg-card.featured{background:linear-gradient(135deg,#fff8f8,#fff);border-left-width:8px}.docg-rank{width:50px;height:50px;background:#c0392b;color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.5rem;font-weight:700;flex-shrink:0}.docg-content h3{margin:0 0 12px;color:#2c3e50;font-size:1.3rem}.docg-content p{margin:6px 0;line-height:1.6}.docg-grape{font-weight:600;color:#c0392b}.super-tuscan{background:linear-gradient(135deg,#f8f9fa,#fff);padding:30px;border-radius:12px}.super-tuscan-intro{margin-bottom:25px;padding-bottom:20px;border-bottom:2px solid #e0e0e0}.super-tuscan-intro h3{color:#c0392b;margin-bottom:15px}.super-tuscan-examples{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.example-wine{background:#fff;padding:20px;border-radius:10px;box-shadow:0 2px 8px rgba(0,0,0,.08);text-align:center}.wine-name{font-size:1.3rem;font-weight:700;color:#c0392b;margin-bottom:10px}.wine-blend{color:#555;margin-bottom:8px;font-size:.95rem}.wine-status{color:#667eea;font-weight:600;font-size:.9rem}.pairing-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.pairing-card{background:#f8f9fa;padding:25px;border-radius:12px;text-align:center}.food-icon{font-size:3rem;margin-bottom:10px}.pairing-card h4{color:#2c3e50;margin:10px 0;font-size:1.1rem}.pairing-card p{margin:5px 0;color:#555}.pairing-wine{color:#c0392b;font-weight:700;margin-top:10px}.summary-points{display:grid;gap:12px}.point-item{background:linear-gradient(90deg,#ffebee,transparent);padding:18px 25px;border-left:4px solid #c0392b;font-size:1.1rem;font-weight:600;color:#2c3e50}</style>",
  "quiz": [
    {
      "question": "托斯卡納最重要的紅葡萄品種是？",
      "options": [
        "Nebbiolo",
        "Sangiovese",
        "Barbera",
        "Primitivo"
      ],
      "answer": 1,
      "explanation": "Sangiovese 是托斯卡納的靈魂品種，種植面積佔該產區 90% 以上。"
    },
    {
      "question": "Brunello di Montalcino 必須使用哪個品種釀造？",
      "options": [
        "100% Sangiovese",
        "100% Cabernet",
        "Sangiovese + Merlot",
        "任何紅葡萄品種"
      ],
      "answer": 0,
      "explanation": "Brunello di Montalcino DOCG 規定必須使用 100% Sangiovese（當地稱為 Brunello）釀造。"
    },
    {
      "question": "「超級托斯卡納」通常標示為什麼等級？",
      "options": [
        "DOCG",
        "DOC",
        "IGT",
        "VdT"
      ],
      "answer": 2,
      "explanation": "超級托斯卡納因使用國際品種或非傳統混釀，通常只能標示為 Toscana IGT。"
    },
    {
      "question": "Chianti Classico 的標誌是什麼？",
      "options": [
        "白鷹",
        "黑公雞",
        "紅獅",
        "金塔"
      ],
      "answer": 1,
      "explanation": "Chianti Classico 的官方標誌是黑公雞（Gallo Nero），代表傳統核心產區。"
    }
  ]
}
