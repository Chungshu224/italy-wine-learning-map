olor:#7f8c8d;font-style:italic;margin:8px 0 20px}.wine-details p{margin:10px 0;padding:10px 15px;background:linear-gradient(90deg,#f8f9fa,transparent);border-left:4px solid;line-height:1.6;font-size:.95rem}.barolo .wine-details p{border-color:#c0392b}.barbaresco .wine-details p{border-color:#9b59b6}.wine-details strong{color:#2c3e50}.key-diff{background:linear-gradient(135deg,#fef5e7,#fff);padding:20px 30px;border-radius:12px;border-left:5px solid #f39c12;text-align:center}.key-diff h4{margin:0 0 10px;color:#f39c12;font-size:1.2rem}.key-diff p{margin:0;font-size:1.1rem;color:#2c3e50;line-height:1.8}.white-wines{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.white-wine-card{background:#fff;padding:25px;border-radius:12px;box-shadow:0 4px 15px rgba(0,0,0,.1)}.white-wine-card.gavi{border-top:5px solid #16a085}.white-wine-card.moscato{border-top:5px solid #f39c12}.white-wine-card.asti{border-top:5px solid #e67e22}.white-wine-card h3{margin:0 0 15px;color:#2c3e50;font-size:1.2rem;text-align:center}.wine-info p{margin:10px 0;padding:8px 12px;background:linear-gradient(90deg,#f8f9fa,transparent);border-left:4px solid #bdc3c7;line-height:1.6;font-size:.95rem}.wine-info strong{color:#2c3e50}.docg-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;margin-bottom:20px}.docg-item{padding:18px 20px;text-align:center;border-radius:10px;font-weight:700;font-size:1.1rem;color:#fff;box-shadow:0 3px 10px rgba(0,0,0,.15)}.tier-s{background:linear-gradient(135deg,#e74c3c,#c0392b)}.tier-a{background:linear-gradient(135deg,#f39c12,#e67e22)}.tier-b{background:linear-gradient(135deg,#3498db,#2980b9)}.tier-c{background:linear-gradient(135deg,#95a5a6,#7f8c8d)}.tier-legend{display:flex;gap:20px;justify-content:center;flex-wrap:wrap}.legend-item{display:flex;align-items:center;gap:8px;font-size:1rem;color:#555}.legend-color{width:30px;height:20px;border-radius:5px}.key-points{display:grid;gap:10px}.point{background:linear-gradient(90deg,#e8daef,transparent);padding:16px 22px;border-left:4px solid #8e44ad;font-size:1.05rem;font-weight:600;color:#2c3e50}</style>",
