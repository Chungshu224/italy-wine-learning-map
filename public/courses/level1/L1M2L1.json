{
  "lessonId": "L1M2L1",
  "title": "Piemonte 皮埃蒙特 - 義大利之王",
  "content": "<div class='slides'><section class='slide-cover' style='background:linear-gradient(135deg,#8e44ad 0%,#9b59b6 100%)'><h1>👑 Piemonte 皮埃蒙特</h1><p class='subtitle'>Barolo 與 Barbaresco 的故鄉</p></section><section class='slide piedmont-map-slide' style='padding:0'><div class='piedmont-map-container' style='display:grid;grid-template-columns:2fr 1fr;gap:20px;height:100%;padding:20px;background:#1a1a2e;border-radius:12px'><div id='piedmont-map' class='piedmont-region-map' style='border-radius:12px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,.3)'></div><div class='map-legend'><h3 style='margin:0 0 20px;color:#8e44ad;font-size:1.3rem;text-align:center'>👑 Piedmont 產區地圖</h3><div style='margin-bottom:25px;padding:15px;background:rgba(142,68,173,.15);border-radius:8px;border-left:4px solid #8e44ad'><p style='margin:0;color:#ecf0f1;line-height:1.7;font-size:.95rem'>義大利之王，Barolo與Barbaresco的故鄉</p></div><div style='margin-bottom:20px'><h4 style='margin:0 0 12px;color:#d4af37;font-size:1.1rem;border-bottom:2px solid #d4af37;padding-bottom:8px'>👑 S級 DOCG</h4><button onclick='zoomToPiedmontRegion(\"Barolo DOCG\")' style='width:100%;text-align:left;margin:8px 0;padding:10px;background:rgba(139,0,0,.1);border:none;border-radius:6px;border-left:3px solid #8B0000;cursor:pointer;transition:all 0.3s' onmouseenter='this.style.background=\"rgba(139,0,0,.2)\"' onmouseleave='this.style.background=\"rgba(139,0,0,.1)\"'><div style='display:flex;align-items:center;margin-bottom:5px'><div style='width:16px;height:16px;background:#8B0000;border-radius:3px;margin-right:10px'></div><strong style='color:#8B0000'>Barolo</strong></div><p style='margin:5px 0 0 26px;color:#bdc3c7;font-size:.88rem;line-height:1.6'>葡萄酒之王，100% Nebbiolo</p></button><button onclick='zoomToPiedmontRegion(\"Barbaresco DOCG\")' style='width:100%;text-align:left;margin:8px 0;padding:10px;background:rgba(142,68,173,.1);border:none;border-radius:6px;border-left:3px solid #8E44AD;cursor:pointer;transition:all 0.3s' onmouseenter='this.style.background=\"rgba(142,68,173,.2)\"' onmouseleave='this.style.background=\"rgba(142,68,173,.1)\"'><div style='display:flex;align-items:center;margin-bottom:5px'><div style='width:16px;height:16px;background:#8E44AD;border-radius:3px;margin-right:10px'></div><strong style='color:#8E44AD'>Barbaresco</strong></div><p style='margin:5px 0 0 26px;color:#bdc3c7;font-size:.88rem;line-height:1.6'>葡萄酒皇后，優雅細膩</p></button></div><div style='margin-bottom:20px'><h4 style='margin:0 0 12px;color:#f39c12;font-size:1.1rem;border-bottom:2px solid #f39c12;padding-bottom:8px'>⭐ A級 DOCG</h4><button onclick='zoomToPiedmontRegion(\"Barbera d\'Asti DOCG\")' style='width:100%;text-align:left;margin:8px 0;padding:10px;background:rgba(41,128,185,.1);border:none;border-radius:6px;border-left:3px solid #2980B9;cursor:pointer;transition:all 0.3s' onmouseenter='this.style.background=\"rgba(41,128,185,.2)\"' onmouseleave='this.style.background=\"rgba(41,128,185,.1)\"'><div style='display:flex;align-items:center;margin-bottom:5px'><div style='width:16px;height:16px;background:#2980B9;border-radius:3px;margin-right:10px'></div><strong style='color:#2980B9'>Barbera d'Asti</strong></div><p style='margin:5px 0 0 26px;color:#bdc3c7;font-size:.88rem;line-height:1.6'>高酸度、性價比之選</p></button><button onclick='zoomToPiedmontRegion(\"Gavi DOCG\")' style='width:100%;text-align:left;margin:8px 0;padding:10px;background:rgba(22,160,133,.1);border:none;border-radius:6px;border-left:3px solid #16a085;cursor:pointer;transition:all 0.3s' onmouseenter='this.style.background=\"rgba(22,160,133,.2)\"' onmouseleave='this.style.background=\"rgba(22,160,133,.1)\"'><div style='display:flex;align-items:center;margin-bottom:5px'><div style='width:16px;height:16px;background:#16a085;border-radius:3px;margin-right:10px'></div><strong style='color:#16a085'>Gavi DOCG</strong></div><p style='margin:5px 0 0 26px;color:#bdc3c7;font-size:.88rem;line-height:1.6'>清爽白酒，礦物感明顯</p></button></div><div style='margin-bottom:20px'><h4 style='margin:0 0 12px;color:#95a5a6;font-size:1.1rem;border-bottom:2px solid #95a5a6;padding-bottom:8px'>💎 B級 DOCG</h4><button onclick='zoomToPiedmontRegion(\"Gattinara DOCG\")' style='width:100%;text-align:left;margin:8px 0;padding:10px;background:rgba(127,140,141,.1);border:none;border-radius:6px;border-left:3px solid #7F8C8D;cursor:pointer;transition:all 0.3s' onmouseenter='this.style.background=\"rgba(127,140,141,.2)\"' onmouseleave='this.style.background=\"rgba(127,140,141,.1)\"'><div style='display:flex;align-items:center;margin-bottom:5px'><div style='width:16px;height:16px;background:#7F8C8D;border-radius:3px;margin-right:10px'></div><strong style='color:#7F8C8D'>Gattinara</strong></div><p style='margin:5px 0 0 26px;color:#bdc3c7;font-size:.88rem;line-height:1.6'>北部 Nebbiolo，清新風格</p></button><button onclick='zoomToPiedmontRegion(\"Ghemme DOCG\")' style='width:100%;text-align:left;margin:8px 0;padding:10px;background:rgba(149,165,166,.1);border:none;border-radius:6px;border-left:3px solid #95A5A6;cursor:pointer;transition:all 0.3s' onmouseenter='this.style.background=\"rgba(149,165,166,.2)\"' onmouseleave='this.style.background=\"rgba(149,165,166,.1)\"'><div style='display:flex;align-items:center;margin-bottom:5px'><div style='width:16px;height:16px;background:#95A5A6;border-radius:3px;margin-right:10px'></div><strong style='color:#95A5A6'>Ghemme</strong></div><p style='margin:5px 0 0 26px;color:#bdc3c7;font-size:.88rem;line-height:1.6'>優雅 Nebbiolo，陳年潛力佳</p></button><button onclick='zoomToPiedmontRegion(\"Dogliani DOCG\")' style='width:100%;text-align:left;margin:8px 0;padding:10px;background:rgba(52,73,94,.1);border:none;border-radius:6px;border-left:3px solid #34495E;cursor:pointer;transition:all 0.3s' onmouseenter='this.style.background=\"rgba(52,73,94,.2)\"' onmouseleave='this.style.background=\"rgba(52,73,94,.1)\"'><div style='display:flex;align-items:center;margin-bottom:5px'><div style='width:16px;height:16px;background:#34495E;border-radius:3px;margin-right:10px'></div><strong style='color:#34495E'>Dogliani</strong></div><p style='margin:5px 0 0 26px;color:#bdc3c7;font-size:.88rem;line-height:1.6'>Dolcetto 優質產區，果香豐富</p></button></div></div></div></section><section class='slide'><h2>📍 產區概況</h2><div class='region-overview'><div class='overview-item'><div class='item-icon'>🏔️</div><div class='item-content'><h4>地理位置</h4><p>義大利西北部</p><p>阿爾卑斯山腳下</p><p>與法國、瑞士接壤</p></div></div><div class='overview-item'><div class='item-icon'>🌾</div><div class='item-content'><h4>葡萄園面積</h4><p>約 45,000 公頃</p><p>丘陵地形為主</p><p>海拔 200-500 公尺</p></div></div><div class='overview-item'><div class='item-icon'>🏆</div><div class='item-content'><h4>法定產區</h4><p>18 個 DOCG</p><p>42 個 DOC</p><p>義大利最高品質產區</p></div></div></div></section><section class='slide'><h2>🌡️ 氣候與風土</h2><div class='climate-section'><div class='climate-card'><h3>🌤️ 大陸性氣候</h3><div class='climate-details'><p><strong>夏季：</strong>炎熱乾燥（25-30°C）</p><p><strong>冬季：</strong>寒冷有雪（0-5°C）</p><p><strong>秋季：</strong>常有霧氣（Nebbia）</p><p><strong>晝夜溫差：</strong>大（10-15°C）</p></div></div><div class='climate-card'><div class='fog-story'><h4>🌫️ Nebbiolo 的由來</h4><p>秋季採收時，皮埃蒙特的丘陵常籠罩在濃霧（Nebbia）中，這也是 <strong>Nebbiolo</strong> 葡萄品種名稱的由來。</p><p class='highlight-text'>霧氣延緩成熟，讓葡萄累積更豐富的風味和單寧。</p></div></div></div></section><section class='slide'><h2>🍇 三大紅葡萄品種</h2><div class='grape-trio'><div class='grape-box king'><div class='grape-badge'>👑 王者</div><h3>Nebbiolo</h3><div class='grape-profile'><p><strong>🎨 顏色：</strong>寶石紅，邊緣磚紅或橙色</p><p><strong>👃 香氣：</strong>玫瑰、紫羅蘭、焦油、皮革、松露</p><p><strong>👅 口感：</strong>高單寧、高酸度、酒體飽滿</p><p><strong>⏱️ 陳年：</strong>10-30 年</p><p><strong>🍷 代表：</strong>Barolo, Barbaresco</p></div></div><div class='grape-box popular'><div class='grape-badge'>⭐ 親民</div><h3>Barbera</h3><div class='grape-profile'><p><strong>🎨 顏色：</strong>深紫紅色</p><p><strong>👃 香氣：</strong>黑櫻桃、黑莓、甘草、紫羅蘭</p><p><strong>👅 口感：</strong>低單寧、高酸度、清爽</p><p><strong>⏱️ 陳年：</strong>2-8 年</p><p><strong>🍷 代表：</strong>Barbera d'Asti, Barbera d'Alba</p></div></div><div class='grape-box easy'><div class='grape-badge'>🍷 日常</div><h3>Dolcetto</h3><div class='grape-profile'><p><strong>🎨 顏色：</strong>深紫色</p><p><strong>👃 香氣：</strong>紅色水果、杏仁、草本</p><p><strong>👅 口感：</strong>中等單寧、低酸度、果香</p><p><strong>⏱️ 陳年：</strong>1-5 年</p><p><strong>🍷 代表：</strong>Dolcetto d'Alba</p></div></div></div></section><section class='slide'><h2>👑 Barolo vs Barbaresco</h2><div class='comparison-layout'><div class='wine-profile barolo'><h3>Barolo</h3><p class='wine-title'>「葡萄酒之王」</p><div class='wine-details'><p><strong>📍 位置：</strong>Alba 西南方</p><p><strong>🌡️ 氣候：</strong>較溫暖</p><p><strong>🏔️ 土壤：</strong>Tortoniano（較重黏土）+ Helvetiano（石灰岩）</p><p><strong>⏱️ 陳年要求：</strong>38 個月（18 個月橡木桶）</p><p><strong>⏱️ Riserva：</strong>62 個月</p><p><strong>💪 風格：</strong>力量型、結構強勁、單寧堅實</p><p><strong>🍷 陳年潛力：</strong>10-30 年</p><p><strong>🍴 配餐：</strong>松露燉飯、燉牛肉、野味、陳年起司</p></div></div><div class='wine-profile barbaresco'><h3>Barbaresco</h3><p class='wine-title'>「葡萄酒皇后」</p><div class='wine-details'><p><strong>📍 位置：</strong>Alba 東北方</p><p><strong>🌡️ 氣候：</strong>較涼爽</p><p><strong>🏔️ 土壤：</strong>以石灰岩為主（較輕）</p><p><strong>⏱️ 陳年要求：</strong>26 個月（9 個月橡木桶）</p><p><strong>⏱️ Riserva：</strong>50 個月</p><p><strong>🌸 風格：</strong>優雅型、細膩柔順、花香明顯</p><p><strong>🍷 陳年潛力：</strong>8-25 年</p><p><strong>🍴 配餐：</strong>白松露、烤雞、小牛肉、中等陳年起司</p></div></div></div><div class='key-diff'><h4>💡 關鍵差異</h4><p>Barolo 是<strong>力量型拳手</strong>，Barbaresco 是<strong>優雅劍客</strong>。都是頂級，風格不同。</p></div></section><section class='slide'><h2>⚪ 白葡萄酒與氣泡酒</h2><div class='white-wines'><div class='white-wine-card gavi'><h3>🥂 Gavi DOCG</h3><div class='wine-info'><p><strong>品種：</strong>Cortese</p><p><strong>風格：</strong>清爽、礦物感、檸檬、青蘋果</p><p><strong>酸度：</strong>高</p><p><strong>配餐：</strong>海鮮、白肉、沙拉、Vitello Tonnato</p><p><strong>適飲期：</strong>1-5 年</p></div></div><div class='white-wine-card moscato'><h3>🍾 Moscato d'Asti DOCG</h3><div class='wine-info'><p><strong>品種：</strong>Moscato Bianco</p><p><strong>風格：</strong>微甜氣泡、桃子、荔枝、玫瑰花香</p><p><strong>酒精度：</strong>低（5-6.5%）</p><p><strong>配餐：</strong>甜點、水果、早午餐</p><p><strong>特點：</strong>清新、低壓氣泡（Frizzante）</p></div></div><div class='white-wine-card asti'><h3>🎉 Asti DOCG</h3><div class='wine-info'><p><strong>品種：</strong>Moscato Bianco</p><p><strong>風格：</strong>甜型氣泡酒、花香濃郁</p><p><strong>酒精度：</strong>6-9%</p><p><strong>配餐：</strong>蛋糕、Panettone、慶祝場合</p><p><strong>特點：</strong>充分氣泡（Spumante）</p></div></div></div></section><section class='slide'><h2>🗺️ Piemonte 9 大重要 DOCG</h2><div class='docg-grid'><div class='docg-item tier-s'>Barolo</div><div class='docg-item tier-s'>Barbaresco</div><div class='docg-item tier-a'>Barbera d'Asti</div><div class='docg-item tier-a'>Gavi</div><div class='docg-item tier-a'>Roero</div><div class='docg-item tier-b'>Dolcetto di Dogliani Superiore</div><div class='docg-item tier-b'>Gattinara</div><div class='docg-item tier-b'>Ghemme</div><div class='docg-item tier-c'>Moscato d'Asti / Asti</div></div><div class='tier-explanation'><h3>📊 分級標準說明</h3><div class='tier-details'><div class='tier-detail tier-s-detail'><h4>🏆 S 級：世界頂級 (Legendary)</h4><p><strong>標準：</strong>國際聲譽最高、陳年潛力 20 年以上、價格頂級</p><p><strong>代表：</strong>Barolo、Barbaresco - 100% Nebbiolo，義大利紅酒巔峰，全球收藏家追捧</p></div><div class='tier-detail tier-a-detail'><h4>⭐ A 級：優質精品 (Premium)</h4><p><strong>標準：</strong>優秀品質、廣受好評、性價比高</p><p><strong>代表：</strong></p><p>• Barbera d'Asti - 高酸度紅酒，適口性佳</p><p>• Gavi - 皮埃蒙特最佳白酒，清爽礦物感</p><p>• Roero - Nebbiolo 親民版，果香豐富</p></div><div class='tier-detail tier-b-detail'><h4>💎 B 級：高品質 (Quality)</h4><p><strong>標準：</strong>傳統產區、品質穩定、值得探索</p><p><strong>代表：</strong></p><p>• Dolcetto di Dogliani Superiore - 日常餐酒之選</p><p>• Gattinara、Ghemme - 北部 Nebbiolo，較清新風格</p></div><div class='tier-detail tier-c-detail'><h4>🌸 C 級：特色酒款 (Specialty)</h4><p><strong>標準：</strong>獨特風格、市場廣受歡迎、入門首選</p><p><strong>代表：</strong>Moscato d'Asti / Asti - 世界最著名微甜氣泡酒，低酒精度，適合慶祝與甜點</p></div></div></div><div class='tier-legend'><div class='legend-item'><span class='legend-color tier-s'></span> S 級：世界頂級</div><div class='legend-item'><span class='legend-color tier-a'></span> A 級：優質精品</div><div class='legend-item'><span class='legend-color tier-b'></span> B 級：高品質</div><div class='legend-item'><span class='legend-color tier-c'></span> C 級：特色酒款</div></div></section><section class='slide'><h2>🎓 重點回顧</h2><div class='key-points'><div class='point'>✓ Piemonte 是義大利最高品質的葡萄酒產區</div><div class='point'>✓ Nebbiolo 是「義大利之王」，釀造 Barolo 和 Barbaresco</div><div class='point'>✓ Barolo 力量型，Barbaresco 優雅型</div><div class='point'>✓ Barbera 高酸低單寧，是性價比之選</div><div class='point'>✓ Moscato d'Asti 是世界最著名的微甜氣泡酒</div></div></section></div><style>.region-overview{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.overview-item{display:flex;gap:15px;align-items:flex-start;background:#fff;padding:25px;border-radius:12px;box-shadow:0 3px 10px rgba(0,0,0,.1)}.item-icon{font-size:3rem}.item-content h4{margin:0 0 10px;color:#8e44ad;font-size:1.2rem}.item-content p{margin:5px 0;color:#555;line-height:1.6}.climate-section{display:grid;grid-template-columns:1fr 1fr;gap:20px}.climate-card{background:#fff;padding:25px;border-radius:12px;box-shadow:0 4px 15px rgba(0,0,0,.1)}.climate-card h3{margin:0 0 15px;color:#8e44ad;font-size:1.3rem}.climate-details p{margin:10px 0;padding:10px 15px;background:linear-gradient(90deg,#f8f9fa,transparent);border-left:4px solid #9b59b6;line-height:1.6}.climate-details strong{color:#2c3e50}.fog-story{background:linear-gradient(135deg,#e8daef,#f4ecf7);padding:20px;border-radius:10px;border-left:5px solid #8e44ad}.fog-story h4{margin:0 0 12px;color:#8e44ad}.fog-story p{margin:10px 0;line-height:1.8;color:#2c3e50}.highlight-text{background:#fff;padding:12px 15px;border-radius:8px;margin-top:12px;font-weight:600;color:#8e44ad}.grape-trio{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.grape-box{background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 4px 15px rgba(0,0,0,.1);position:relative;padding-top:40px}.grape-badge{position:absolute;top:12px;left:50%;transform:translateX(-50%);background:#8e44ad;color:#fff;padding:6px 18px;border-radius:20px;font-size:.85rem;font-weight:700}.grape-box.popular .grape-badge{background:#3498db}.grape-box.easy .grape-badge{background:#27ae60}.grape-box h3{text-align:center;margin:0 0 15px;font-size:1.4rem;color:#2c3e50}.grape-profile{padding:0 20px 20px}.grape-profile p{margin:10px 0;padding:8px 12px;background:linear-gradient(90deg,#f8f9fa,transparent);border-left:4px solid #9b59b6;font-size:.95rem;line-height:1.6}.grape-profile strong{color:#2c3e50}.comparison-layout{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px}.wine-profile{background:#fff;padding:30px;border-radius:12px;box-shadow:0 4px 15px rgba(0,0,0,.1)}.wine-profile.barolo{border-top:6px solid #c0392b}.wine-profile.barbaresco{border-top:6px solid #9b59b6}.wine-profile h3{margin:0;font-size:1.8rem;color:#2c3e50;text-align:center}.wine-title{text-align:center;font-size:1.1rem;color:#7f8c8d;font-style:italic;margin:8px 0 20px}.wine-details p{margin:10px 0;padding:10px 15px;background:linear-gradient(90deg,#f8f9fa,transparent);border-left:4px solid;line-height:1.6;font-size:.95rem}.barolo .wine-details p{border-color:#c0392b}.barbaresco .wine-details p{border-color:#9b59b6}.wine-details strong{color:#2c3e50}.key-diff{background:linear-gradient(135deg,#fef5e7,#fff);padding:20px 30px;border-radius:12px;border-left:5px solid #f39c12;text-align:center}.key-diff h4{margin:0 0 10px;color:#f39c12;font-size:1.2rem}.key-diff p{margin:0;font-size:1.1rem;color:#2c3e50;line-height:1.8}.white-wines{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.white-wine-card{background:#fff;padding:25px;border-radius:12px;box-shadow:0 4px 15px rgba(0,0,0,.1)}.white-wine-card.gavi{border-top:5px solid #16a085}.white-wine-card.moscato{border-top:5px solid #f39c12}.white-wine-card.asti{border-top:5px solid #e67e22}.white-wine-card h3{margin:0 0 15px;color:#2c3e50;font-size:1.2rem;text-align:center}.wine-info p{mar