{
  "lessonId": "L1M2L3",
  "title": "Veneto 威尼托 - 水都風情",
  "content": "<div class='slides'><section class='slide-cover' style='background:linear-gradient(135deg,#16a085 0%,#1abc9c 100%)'><h1>🍷 Veneto 威尼托</h1><p class='subtitle'>從 Prosecco 到 Amarone 的多樣世界</p></section><section class='slide veneto-map-slide' style='padding:0'><div class='veneto-map-container' style='display:grid;grid-template-columns:2fr 1fr;gap:20px;height:100%;padding:20px;background:#1a1a2e;border-radius:12px'><div id='veneto-map' class='veneto-region-map' style='border-radius:12px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,.3)'></div><div class='map-legend'><h3 style='margin:0 0 20px;color:#16a085;font-size:1.3rem;text-align:center'>🍷 Veneto 產區地圖</h3><div style='margin-bottom:25px;padding:15px;background:rgba(22,160,133,.15);border-radius:8px;border-left:4px solid #16a085'><p style='margin:0;color:#ecf0f1;line-height:1.7;font-size:.95rem'>從Prosecco到Amarone的多樣世界</p></div><div style='margin-bottom:20px'><h4 style='margin:0 0 12px;color:#d4af37;font-size:1.1rem;border-bottom:2px solid #d4af37;padding-bottom:8px'>🏆 S級 DOCG</h4><button onclick='zoomToVenetoRegion(&quot;Amarone della Valpolicella DOCG&quot;)' style='width:100%;text-align:left;margin:8px 0;padding:10px;background:rgba(139,0,0,.1);border:none;border-radius:6px;border-left:3px solid #8B0000;cursor:pointer;transition:all 0.3s' onmouseenter='this.style.background=&quot;rgba(139,0,0,.2)&quot;' onmouseleave='this.style.background=&quot;rgba(139,0,0,.1)&quot;'><div style='display:flex;align-items:center;margin-bottom:5px'><div style='width:16px;height:16px;background:#8B0000;border-radius:3px;margin-right:10px'></div><strong style='color:#8B0000'>Amarone della Valpolicella</strong></div><p style='margin:5px 0 0 26px;color:#bdc3c7;font-size:.88rem;line-height:1.6'>風乾工藝，濃郁強勁</p></button><button onclick='zoomToVenetoRegion(&quot;Recioto della Valpolicella DOCG&quot;)' style='width:100%;text-align:left;margin:8px 0;padding:10px;background:rgba(165,42,42,.1);border:none;border-radius:6px;border-left:3px solid #A52A2A;cursor:pointer;transition:all 0.3s' onmouseenter='this.style.background=&quot;rgba(165,42,42,.2)&quot;' onmouseleave='this.style.background=&quot;rgba(165,42,42,.1)&quot;'><div style='display:flex;align-items:center;margin-bottom:5px'><div style='width:16px;height:16px;background:#A52A2A;border-radius:3px;margin-right:10px'></div><strong style='color:#A52A2A'>Recioto della Valpolicella</strong></div><p style='margin:5px 0 0 26px;color:#bdc3c7;font-size:.88rem;line-height:1.6'>甜紅酒版本</p></button></div><div style='margin-bottom:20px'><h4 style='margin:0 0 12px;color:#f39c12;font-size:1.1rem;border-bottom:2px solid #f39c12;padding-bottom:8px'>⭐ A級 DOCG</h4><button onclick='zoomToVenetoRegion(&quot;Conegliano Valdobbiadene Prosecco DOCG&quot;)' style='width:100%;text-align:left;margin:8px 0;padding:10px;background:rgba(39,174,96,.1);border:none;border-radius:6px;border-left:3px solid #27ae60;cursor:pointer;transition:all 0.3s' onmouseenter='this.style.background=&quot;rgba(39,174,96,.2)&quot;' onmouseleave='this.style.background=&quot;rgba(39,174,96,.1)&quot;'><div style='display:flex;align-items:center;margin-bottom:5px'><div style='width:16px;height:16px;background:#27ae60;border-radius:3px;margin-right:10px'></div><strong style='color:#27ae60'>Conegliano Valdobbiadene Prosecco</strong></div><p style='margin:5px 0 0 26px;color:#bdc3c7;font-size:.88rem;line-height:1.6'>頂級Prosecco氣泡酒</p></button><button onclick='zoomToVenetoRegion(&quot;Soave Superiore DOCG&quot;)' style='width:100%;text-align:left;margin:8px 0;padding:10px;background:rgba(46,204,113,.1);border:none;border-radius:6px;border-left:3px solid #2ecc71;cursor:pointer;transition:all 0.3s' onmouseenter='this.style.background=&quot;rgba(46,204,113,.2)&quot;' onmouseleave='this.style.background=&quot;rgba(46,204,113,.1)&quot;'><div style='display:flex;align-items:center;margin-bottom:5px'><div style='width:16px;height:16px;background:#2ecc71;border-radius:3px;margin-right:10px'></div><strong style='color:#2ecc71'>Soave Superiore</strong></div><p style='margin:5px 0 0 26px;color:#bdc3c7;font-size:.88rem;line-height:1.6'>Garganega清爽白酒</p></button></div><div style='margin-bottom:20px'><h4 style='margin:0 0 12px;color:#3498db;font-size:1.1rem;border-bottom:2px solid #3498db;padding-bottom:8px'>💎 B級產區</h4><button onclick='zoomToVenetoRegion(&quot;Bardolino Superiore DOCG&quot;)' style='width:100%;text-align:left;margin:8px 0;padding:10px;background:rgba(52,152,219,.1);border:none;border-radius:6px;border-left:3px solid #3498db;cursor:pointer;transition:all 0.3s' onmouseenter='this.style.background=&quot;rgba(52,152,219,.2)&quot;' onmouseleave='this.style.background=&quot;rgba(52,152,219,.1)&quot;'><div style='display:flex;align-items:center;margin-bottom:5px'><div style='width:16px;height:16px;background:#3498db;border-radius:3px;margin-right:10px'></div><strong style='color:#3498db'>Bardolino Superiore</strong></div><p style='margin:5px 0 0 26px;color:#bdc3c7;font-size:.88rem;line-height:1.6'>清新紅酒，加爾達湖畔</p></button><button onclick='zoomToVenetoRegion(&quot;Lison DOCG&quot;)' style='width:100%;text-align:left;margin:8px 0;padding:10px;background:rgba(93,173,226,.1);border:none;border-radius:6px;border-left:3px solid #5DADE2;cursor:pointer;transition:all 0.3s' onmouseenter='this.style.background=&quot;rgba(93,173,226,.2)&quot;' onmouseleave='this.style.background=&quot;rgba(93,173,226,.1)&quot;'><div style='display:flex;align-items:center;margin-bottom:5px'><div style='width:16px;height:16px;background:#5DADE2;border-radius:3px;margin-right:10px'></div><strong style='color:#5DADE2'>Lison</strong></div><p style='margin:5px 0 0 26px;color:#bdc3c7;font-size:.88rem;line-height:1.6'>Friulano白酒，清新礦物感</p></button><button onclick='zoomToVenetoRegion(&quot;Colli di Conegliano DOCG&quot;)' style='width:100%;text-align:left;margin:8px 0;padding:10px;background:rgba(133,193,226,.1);border:none;border-radius:6px;border-left:3px solid #85C1E2;cursor:pointer;transition:all 0.3s' onmouseenter='this.style.background=&quot;rgba(133,193,226,.2)&quot;' onmouseleave='this.style.background=&quot;rgba(133,193,226,.1)&quot;'><div style='display:flex;align-items:center;margin-bottom:5px'><div style='width:16px;height:16px;background:#85C1E2;border-radius:3px;margin-right:10px'></div><strong style='color:#85C1E2'>Colli di Conegliano</strong></div><p style='margin:5px 0 0 26px;color:#bdc3c7;font-size:.88rem;line-height:1.6'>Conegliano丘陵，紅白酒皆有</p></button></div></div></div></section><section class='slide'><h2>📍 產區概況</h2><div class='region-stats'><div class='stat-box'><div class='stat-icon'>📍</div><div class='stat-content'><div class='stat-number'>義大利東北部</div><div class='stat-desc'>威尼斯大區</div></div></div><div class='stat-box'><div class='stat-icon'>🌾</div><div class='stat-content'><div class='stat-number'>~80,000 ha</div><div class='stat-desc'>義大利第二大產區</div></div></div><div class='stat-box'><div class='stat-icon'>🏆</div><div class='stat-content'><div class='stat-number'>14 DOCG + 14 DOC</div><div class='stat-desc'>法定產區</div></div></div><div class='stat-box'><div class='stat-icon'>🍾</div><div class='stat-content'><div class='stat-number'>#1</div><div class='stat-desc'>義大利最大 Prosecco 產區</div></div></div></div></section><section class='slide'><h2>🏛 歷史與文化地位</h2><div class='history-timeline'><div class='timeline-header'><h3 style='color:#16a085;margin-bottom:20px'>威尼斯：葡萄酒貿易的黃金時代</h3></div><div class='era-section'><div class='era-title' style='background:linear-gradient(90deg,#8e44ad,#9b59b6);color:#fff;padding:12px 20px;border-radius:8px;font-weight:700;margin-bottom:15px'>🏛 羅馬時期（公元前1世紀）</div><div class='era-content' style='background:#f8f9fa;padding:20px;border-radius:8px;border-left:4px solid #9b59b6;margin-bottom:20px'><p style='margin:0 0 10px;line-height:1.8'><strong>Pliny the Elder</strong> 在《自然史》中讚美 <strong>Valpolicella 的 Rhaetic 葡萄酒</strong></p><p style='margin:0;color:#555;line-height:1.8'>羅馬人將 Valpolicella 列為帝國最優質葡萄酒之一，與 Falernian 齊名</p></div></div><div class='era-section'><div class='era-title' style='background:linear-gradient(90deg,#c0392b,#e74c3c);color:#fff;padding:12px 20px;border-radius:8px;font-weight:700;margin-bottom:15px'>🏰 中世紀（1000-1400年）</div><div class='era-content' style='background:#f8f9fa;padding:20px;border-radius:8px;border-left:4px solid #e74c3c;margin-bottom:20px'><ul style='margin:10px 0;padding-left:20px;line-height:2'><li><strong>Corvina 和 Garganega</strong> 品種首次被文獻記載</li><li>修道院成為葡萄酒釀造技術中心</li><li>Recioto（甜紅酒）成為貴族宴會的珍品</li></ul></div></div><div class='era-section'><div class='era-title' style='background:linear-gradient(90deg,#d4af37,#f39c12);color:#fff;padding:12px 20px;border-radius:8px;font-weight:700;margin-bottom:15px'>⚜ 威尼斯共和國（697-1797）</div><div class='era-content' style='background:#fff9e6;padding:20px;border-radius:8px;border-left:4px solid #f39c12;margin-bottom:20px'><p style='margin:0 0 15px;font-size:1.05rem;font-weight:600;color:#d4af37'>🌟 葡萄酒貿易的巔峰時期</p><ul style='margin:0;padding-left:20px;line-height:2'><li><strong>威尼斯商人</strong>將 Veneto 葡萄酒運往全歐洲和東地中海</li><li><strong>Andrea Palladio</strong> 設計的別墅莊園成為葡萄園文化象徵</li><li>貿易繁榮推動釀酒技術創新</li><li>Veneto 葡萄酒成為威尼斯外交贈禮</li></ul></div></div><div class='era-section'><div class='era-title' style='background:linear-gradient(90deg,#16a085,#1abc9c);color:#fff;padding:12px 20px;border-radius:8px;font-weight:700;margin-bottom:15px'>🚀 現代發展（20世紀至今）</div><div class='era-content' style='background:#e8f8f5;padding:20px;border-radius:8px;border-left:4px solid #1abc9c'><div style='display:grid;grid-template-columns:1fr 1fr;gap:15px'><div class='milestone'><p style='margin:0 0 8px;font-weight:700;color:#16a085'>📅 1950年代</p><p style='margin:0;line-height:1.7'>Amarone 釀造技術正式確立；從 Recioto 的「意外產物」成為獨立風格</p></div><div class='milestone'><p style='margin:0 0 8px;font-weight:700;color:#16a085'>📅 1968年</p><p style='margin:0;line-height:1.7'>Valpolicella DOC 成立；確立品質標準和產區界線</p></div><div class='milestone'><p style='margin:0 0 8px;font-weight:700;color:#16a085'>📅 2009年</p><p style='margin:0;line-height:1.7'>Conegliano Valdobbiadene 升級 DOCG；Prosecco 開始全球征服</p></div><div class='milestone'><p style='margin:0 0 8px;font-weight:700;color:#16a085'>📅 2010年代</p><p style='margin:0;line-height:1.7'>Prosecco 銷量超越 Champagne；成為世界第一氣泡酒</p></div></div></div></div></div><div class='cultural-note' style='margin-top:25px;padding:20px;background:linear-gradient(135deg,#667eea,#764ba2);border-radius:12px;color:#fff'><p style='margin:0;font-size:1.05rem;line-height:1.8;text-align:center'><strong>💎 文化遺產</strong>：Prosecco Hills of Conegliano and Valdobbiadene 於 2019 年被列入 UNESCO 世界遺產</p></div></section><section class='slide'><h2>🌍 風土條件深度分析</h2><div class='terroir-analysis'><div style='background:linear-gradient(135deg,#16a085,#1abc9c);padding:20px;border-radius:12px;margin-bottom:25px;color:#fff;text-align:center'><p style='margin:0;font-size:1.1rem;line-height:1.8'>從 Dolomites 山脈到 Po 河平原，多樣地形成就Veneto的葡萄酒多樣性</p></div><div style='display:grid;gap:20px;margin-bottom:25px'><div style='background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 4px 15px rgba(0,0,0,.1)'><div style='background:linear-gradient(135deg,#27ae60,#2ecc71);padding:15px 20px;color:#fff'><h3 style='margin:0;font-size:1.2rem'>🏔 東部 - Prosecco 地區</h3><p style='margin:5px 0 0;font-size:.9rem;opacity:.9'>Conegliano-Valdobbiadene</p></div><div style='padding:20px'><p style='margin:0 0 15px'><strong style='color:#27ae60'>📍 地理</strong>：丘陵地帶（150-500m）、陡峭斜坡、朝南  |  <strong style='color:#27ae60'>🌡 氣候</strong>：涼爽、日夜溫差大、年降雨1200mm</p><p style='margin:0 0 15px'><strong style='color:#27ae60'>🪨 土壤</strong>：石灰岩、黏土、白堊質、排水良好  |  <strong style='color:#27ae60'>🍇 適合</strong>：Glera（Prosecco）、芳香型白酒</p><div style='background:#e8f8f5;padding:15px;border-radius:8px;border-left:4px solid #27ae60'><p style='margin:0;line-height:1.7'><strong>🌟 為何優質</strong>：涼爽氣候保持Glera的清新度和花香，石灰岩土壤賦予礦物感</p></div></div></div><div style='background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 4px 15px rgba(0,0,0,.1)'><div style='background:linear-gradient(135deg,#8e44ad,#9b59b6);padding:15px 20px;color:#fff'><h3 style='margin:0;font-size:1.2rem'>🍷 中西部 - Valpolicella和Soave</h3><p style='margin:5px 0 0;font-size:.9rem;opacity:.9'>經典產區核心</p></div><div style='padding:20px'><p style='margin:0 0 15px'><strong style='color:#8e44ad'>📍 地理</strong>：丘陵山谷（100-450m）、朝南東南坡  |  <strong style='color:#8e44ad'>🌡 氣候</strong>：溫和、Garda湖調節、年降雨900mm</p><p style='margin:0 0 15px'><strong style='color:#8e44ad'>🪨 土壤</strong>：火山岩、石灰岩、冰川沉積  |  <strong style='color:#8e44ad'>🍇 適合</strong>：Corvina、Rondinella、Garganega</p><div style='background:#f4ecf7;padding:15px;border-radius:8px;border-left:4px solid #9b59b6'><p style='margin:0;line-height:1.7'><strong>🌟 Valpolicella Classico優勢</strong>：貧瘠火山岩土壤 + 理想朝向 + 卓越排水 = Amarone的完美風土</p></div></div></div><div style='background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 4px 15px rgba(0,0,0,.1)'><div style='background:linear-gradient(135deg,#3498db,#5dade2);padding:15px 20px;color:#fff'><h3 style='margin:0;font-size:1.2rem'>🌾 南部 - Po河平原</h3><p style='margin:5px 0 0;font-size:.9rem;opacity:.9'>大量生產區</p></div><div style='padding:20px'><p style='margin:0 0 15px'><strong style='color:#3498db'>📍 地理</strong>：平原（0-50m）、平坦開闊  |  <strong style='color:#3498db'>🌡 氣候</strong>：溫暖潮濕、夏季炎熱</p><p style='margin:0 0 15px'><strong style='color:#3498db'>🪨 土壤</strong>：沖積土黏土、肥沃保水  |  <strong style='color:#3498db'>🍇 產出</strong>：大量基本款DOC、入門級葡萄酒</p><div style='background:#ebf5fb;padding:15px;border-radius:8px;border-left:4px solid #3498db'><p style='margin:0;line-height:1.7'><strong>📊 產量導向</strong>：高產量性價比高，支撐Veneto成為義大利第二大產區</p></div></div></div></div></div></section><section class='slide'><h2>🧬 Corvina與本土品種深度</h2><div style='background:linear-gradient(135deg,#8e44ad,#9b59b6);padding:25px;border-radius:12px;color:#fff;margin-bottom:25px'><h3 style='margin:0 0 15px;font-size:1.3rem;text-align:center'>👑 Corvina - Valpolicella之王</h3><p style='margin:0 0 15px;line-height:1.8'><strong>品種特性</strong>：厚皮高酸（天然防腐劑）、中等單寧、芳香豐富（櫻桃紫羅蘭香料）、顏色不太深</p><p style='margin:0;line-height:1.8'><strong>為何適合Appassimento</strong>：厚皮風乾不易破裂，高酸平衡濃縮糖分，3-4個月風乾不腐爛，濃縮出乾果巧克力香</p></div><div style='background:#fff;padding:20px;border-radius:12px;box-shadow:0 4px 15px rgba(0,0,0,.1);margin-bottom:20px'><h4 style='margin:0 0 15px;color:#c0392b'>🍷 Rondinella（輔助品種）</h4><p style='margin:0;line-height:1.8'>比例：5-30% | 角色：增加深度顏色、提供結構和單寧、中性風味不干擾Corvina</p></div><div style='background:#fff;padding:20px;border-radius:12px;box-shadow:0 4px 15px rgba(0,0,0,.1);margin-bottom:20px'><h4 style='margin:0 0 15px;color:#16a085'>🌟 Garganega - Soave之魂</h4><p style='margin:0 0 15px;line-height:1.8'><strong>品種特性</strong>：高酸度（清爽適合陳年）、晚熟、產量高（需控制收成）、中性基底（反映風土）</p><p style='margin:0 0 15px;line-height:1.8'><strong>香氣特徵</strong>：白花、檸檬、青蘋果、礦物、杏仁（陳年後）</p><p style='margin:0;line-height:1.8'><strong>老藤的魔力</strong>：40-80年老藤展現驚人深度，濃郁礦物感、蜂蜜杏桃乾香氣、20年+陳年潛力</p></div><div style='background:linear-gradient(135deg,#27ae60,#2ecc71);color:#fff;padding:20px;border-radius:12px'><h4 style='margin:0 0 15px;font-size:1.2rem'>🥂 Glera - Prosecco專用品種</h4><p style='margin:0;line-height:1.8'><strong>香氣</strong>：白花綠蘋果梨子桃子  |  <strong>風格</strong>：清新輕盈低酒精（10.5-12%）  |  <strong>特點</strong>：早熟高產中性易飲不適合陳年</p><p style='margin:10px 0 0;text-align:center'>2009年起，Glera成為品種名，Prosecco成為產地專用名</p></div></section><section class='slide'><h2>✨ 三大明星酒款</h2><div class='wine-showcase'><div class='showcase-item prosecco'><div class='showcase-header'><h3>🥂 Prosecco</h3><span class='wine-type'>氣泡酒</span></div><div class='showcase-body'><p><strong>品種：</strong>Glera 85% 以上</p><p><strong>產區：</strong>Prosecco DOC / Valdobbiadene DOCG</p><p><strong>風格：</strong>清新、果香、氣泡細膩</p><p><strong>價格：</strong>$-$$</p><p><strong>搭配：</strong>開胃菜、海鮮、brunch</p></div></div><div class='showcase-item amarone'><div class='showcase-header'><h3>🍷 Amarone della Valpolicella</h3><span class='wine-type'>DOCG 紅酒</span></div><div class='showcase-body'><p><strong>品種：</strong>Corvina, Rondinella, Molinara</p><p><strong>工藝：</strong>風乾葡萄（Appassimento）</p><p><strong>風格：</strong>濃郁、甜美、酒精度高（15-17%）</p><p><strong>價格：</strong>$$$-$$$$</p><p><strong>搭配：</strong>燉肉、野味、陳年起司</p></div></div><div class='showcase-item soave'><div class='showcase-header'><h3>🌟 Soave</h3><span class='wine-type'>DOCG 白酒</span></div><div class='showcase-body'><p><strong>品種：</strong>Garganega 70% 以上</p><p><strong>產區：</strong>Soave Classico DOCG</p><p><strong>風格：</strong>清爽、礦物感、杏仁香</p><p><strong>價格：</strong>$$</p><p><strong>搭配：</strong>白肉、淡水魚、沙拉</p></div></div></div></section><section class='slide'><h2>� Appassimento工藝與Amarone深度探索</h2><div style='background:#fff;padding:20px;border-radius:12px;box-shadow:0 4px 15px rgba(0,0,0,.1);margin-bottom:20px'><h3 style='margin:0 0 15px;color:#8e44ad'>🌬 Appassimento風乾法 - 完整流程</h3><div style='display:grid;gap:15px'><div style='background:linear-gradient(90deg,#e8f8f5,#fff);padding:15px;border-radius:8px;border-left:5px solid #16a085'><p style='margin:0;font-weight:700;color:#16a085'>1️⃣ 嚴格採收（9-10月）</p><p style='margin:5px 0 0'>人工逐串挑選最健康成熟的葡萄串，剔除病害破損，選擇鬆散果串（通風更好），必須乾燥天氣避免雨後</p></div><div style='background:linear-gradient(90deg,#fef5e7,#fff);padding:15px;border-radius:8px;border-left:5px solid #f39c12'><p style='margin:0;font-weight:700;color:#f39c12'>2️⃣ Fruttai（風乾室）</p><p style='margin:5px 0 0'>傳統：木竹棚架、單層平鋪、自然通風  |  現代：溫濕度控制系統、除濕防霉、理想10-15°C和60-70%濕度</p></div><div style='background:linear-gradient(90deg,#fdedec,#fff);padding:15px;border-radius:8px;border-left:5px solid #e74c3c'><p style='margin:0;font-weight:700;color:#e74c3c'>3️⃣ 風乾過程（3-4個月）</p><p style='margin:5px 0 0'>第1個月：15-20%水分損失，果皮起皺 | 第2-3個月：25-35%緩慢濃縮，檢查霉變 | 第4個月：30-40%達到最佳濃縮度<br><strong>化學變化</strong>：糖分濃縮25-30%、酸度保持、多酚增加、甘油積累、風味複雜化</p></div><div style='background:linear-gradient(90deg,#f4ecf7,#fff);padding:15px;border-radius:8px;border-left:5px solid #8e44ad'><p style='margin:0;font-weight:700;color:#8e44ad'>4️⃣ 釀造與陳年</p><p style='margin:5px 0 0'>緩慢發酵（30-50天）、橡木桶陳年、Amarone最少2年（Riserva 4年）、瓶陳額外6-12個月 | 酒精度高原因：濃縮糖分完全發酵產生15-17%酒精</p></div></div></div><div style='background:#fff;padding:20px;border-radius:12px;box-shadow:0 4px 15px rgba(0,0,0,.1);margin-bottom:20px'><h3 style='margin:0 0 15px;color:#8e44ad'>🏆 Amarone風格類型</h3><div style='display:grid;grid-template-columns:1fr 1fr;gap:15px'><div style='background:linear-gradient(145deg,#fff5f5,#fff);padding:15px;border-radius:8px;border-top:4px solid #c0392b'><h4 style='margin:0 0 10px;color:#c0392b'>🔥 傳統風格</h4><p style='margin:0;font-size:.9rem;line-height:1.7'>代表：Quintarelli、Dal Forno Romano<br>特徵：更長風乾（4個月+）、大橡木桶（5-8年）、極致濃郁甜美、乾果巧克力香料、酒精16-17%、價格$$$$</p></div><div style='background:linear-gradient(145deg,#f0f9ff,#fff);padding:15px;border-radius:8px;border-top:4px solid #3498db'><h4 style='margin:0 0 10px;color:#3498db'>✨ 現代風格</h4><p style='margin:0;font-size:.9rem;line-height:1.7'>代表：Allegrini、Masi、Zenato<br>特徵：標準風乾（3-3.5個月）、小橡木桶（2-4年）、優雅平衡、保留新鮮果味、酒精15-16%、價格$$$</p></div></div></div><div style='display:grid;grid-template-columns:1fr 1fr;gap:15px'><div style='background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 4px 15px rgba(0,0,0,.1)'><div style='background:linear-gradient(135deg,#e67e22,#f39c12);padding:15px;color:#fff'><h4 style='margin:0;text-align:center'>🔄 Ripasso - 二次發酵</h4></div><div style='padding:15px'><p style='margin:0;line-height:1.7'>將已發酵完成的Valpolicella倒入剛榨完的Amarone酒渣上進行第二次發酵。效果：酒精度提升至13-14%、萃取更多單寧和風味、增加複雜度、中等價格（$$-$$$）。「Baby Amarone」</p></div></div><div style='background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 4px 15px rgba(0,0,0,.1)'><div style='background:linear-gradient(135deg,#8e44ad,#9b59b6);padding:15px;color:#fff'><h4 style='margin:0;text-align:center'>🍇 Recioto - 甜紅酒始祖</h4></div><div style='padding:15px'><p style='margin:0;line-height:1.7'>Recioto才是原始版本，Amarone是意外產物（發酵未停止糖分完全轉化）。停止發酵保留4-8%殘糖、酒精12-14%、櫻桃酒漬黑巧克力無花果、甜而不膩單寧平衡。配餐：黑巧克力甜點藍紋起司堅果塔</p></div></div></div></section><section class='slide'><h2>🥂 Prosecco革命與氣泡酒產業</h2><div style='background:linear-gradient(135deg,#27ae60,#2ecc71);padding:20px;border-radius:12px;margin-bottom:20px;color:#fff;text-align:center'><h3 style='margin:0 0 10px'>從地方小酒到全球現象</h3><p style='margin:0;font-size:1.05rem'>2010年代，Prosecco銷量超越Champagne，成為世界第一氣泡酒</p></div><div style='background:#fff;padding:20px;border-radius:12px;box-shadow:0 4px 15px rgba(0,0,0,.1);margin-bottom:20px'><h3 style='margin:0 0 15px;color:#27ae60'>🏔 Prosecco金字塔體系</h3><div style='display:grid;gap:12px'><div style='background:linear-gradient(135deg,#f1c40f,#f39c12);padding:15px;border-radius:8px;color:#fff'><h4 style='margin:0 0 10px'>🌟 Cartizze（頂峰）- DOCG</h4><p style='margin:0;line-height:1.7;font-size:.95rem'>Prosecco的Grand Cru，僅107公頃極稀有，Valdobbiadene的黃金斜坡（250-350m朝南），石灰岩黏土礦物豐富，最濃郁圓潤複雜常做Dry或Extra Dry略甜，價格€25-€50+（普通Prosecco的3-5倍）</p></div><div style='background:linear-gradient(135deg,#16a085,#1abc9c);padding:15px;border-radius:8px;color:#fff'><h4 style='margin:0 0 10px'>🏆 Conegliano Valdobbiadene DOCG</h4><p style='margin:0;line-height:1.7;font-size:.95rem'>頂級Prosecco核心區，15個村莊約6900公頃，丘陵陡坡人工採收，Rive單一村莊葡萄園類似Cru，優雅清新礦物感花香突出，價格€12-€25</p></div><div style='background:linear-gradient(135deg,#3498db,#5dade2);padding:15px;border-radius:8px;color:#fff'><h4 style='margin:0 0 10px'>⭐ Asolo Prosecco DOCG</h4><p style='margin:0;line-height:1.7;font-size:.95rem'>小而精產區約1800公頃，Treviso以西丘陵，較濃郁果香更豐富，價格€10-€20</p></div><div style='background:linear-gradient(135deg,#95a5a6,#bdc3c7);padding:15px;border-radius:8px;color:#fff'><h4 style='margin:0 0 10px'>📍 Prosecco DOC（廣域）</h4><p style='margin:0;line-height:1.7;font-size:.95rem'>跨越Veneto和Friuli 9個省份，全球Prosecco的80%+，平原緩坡機械採收，輕盈易飲簡單果香，價格€6-€12超市常見</p></div></div></div><div style='background:#fff;padding:20px;border-radius:12px;box-shadow:0 4px 15px rgba(0,0,0,.1);margin-bottom:20px'><h3 style='margin:0 0 15px;color:#27ae60'>🔬 Charmat法（Tank Method）</h3><p style='margin:0 0 10px;line-height:1.7'>生產流程：基酒釀造（5-7天）→ 轉入密封大槽（不鏽鋼加壓槽Autoclave）→ 二次發酵（添加糖和酵母15-20天）→ 穩定過濾（低溫穩定過濾酵母）→ 加壓裝瓶（保持4-6 bar壓力）</p><p style='margin:0;padding:12px;background:#fff9e6;border-radius:8px;border-left:4px solid #f39c12;line-height:1.7'><strong>🎯 為何不用傳統法</strong>：Glera品種不適合長時間酵母接觸，Charmat法保留新鮮果香和花香，符合Prosecco清新風格</p></div><div style='background:#fff;padding:20px;border-radius:12px;box-shadow:0 4px 15px rgba(0,0,0,.1)'><h3 style='margin:0 0 15px;color:#27ae60'>🥊 Prosecco vs Champagne</h3><p style='margin:0 0 8px;line-height:1.7'><strong>產地</strong>：義大利Veneto/Friuli vs 法國Champagne | <strong>品種</strong>：Glera單一品種 vs Chardonnay/Pinot混釀</p><p style='margin:0 0 8px;line-height:1.7'><strong>方法</strong>：Charmat槽中二次發酵30-60天 vs 傳統法瓶中二次發酵15個月至數年</p><p style='margin:0 0 8px;line-height:1.7'><strong>風格</strong>：清新果香花香輕盈 vs 複雜酵母香礦物結構 | <strong>氣泡</strong>：較大活潑 vs 細膩持久</p><p style='margin:0 0 8px;line-height:1.7'><strong>價格</strong>：€6-€50 vs €25-€300+ | <strong>全球銷量</strong>：約5.5億瓶/年 vs 約3億瓶/年（2020+）</p><div style='margin-top:15px;padding:15px;background:linear-gradient(135deg,#e8f8f5,#d1f2eb);border-radius:8px;text-align:center'><p style='margin:0;font-weight:700;color:#16a085'>🚀 Prosecco成功秘訣：親民價格 + 輕鬆風格 + 靈活飲用場景</p></div></div></section><section class='slide'><h2>🏰 知名酒莊與精選酒款</h2><div style='background:linear-gradient(135deg,#8e44ad,#9b59b6);padding:15px;border-radius:12px;margin-bottom:20px;color:#fff;text-align:center'><p style='margin:0;font-size:1.05rem'>從傳統大師到現代先鋒，探索Veneto的頂尖生產者</p></div><div style='background:#fff;padding:20px;border-radius:12px;box-shadow:0 4px 15px rgba(0,0,0,.1);margin-bottom:20px'><h3 style='margin:0 0 15px;color:#8e44ad;border-bottom:3px solid #8e44ad;padding-bottom:8px'>🍷 Amarone名莊</h3><div style='display:grid;gap:15px'><div style='background:linear-gradient(145deg,#fff5f5,#fff);padding:15px;border-radius:12px;border-left:5px solid #c0392b'><h4 style='margin:0 0 10px;color:#c0392b'>Dal Forno Romano（S級）</h4><p style='margin:0 0 10px;line-height:1.7;font-size:.95rem'><strong>風格</strong>：極致濃郁派，Amarone的「膜拜酒」 | <strong>位置</strong>：Valpolicella Classico<br><strong>哲學</strong>：極低產量（20-25 hl/ha）、超長風乾（5個月+）、大量新橡木桶</p><p style='margin:0;padding:12px;background:#fadbd8;border-radius:6px;line-height:1.7;font-size:.9rem'><strong>代表作</strong>：Amarone della Valpolicella（17%酒精極致濃郁需陳年10-20年，€300-€600）、Valpolicella Superiore（€100-€150）</p></div><div style='background:linear-gradient(145deg,#fef5e7,#fff);padding:15px;border-radius:12px;border-left:5px solid #d4af37'><h4 style='margin:0 0 10px;color:#d4af37'>Giuseppe Quintarelli（傳奇）</h4><p style='margin:0 0 10px;line-height:1.7;font-size:.95rem'><strong>風格</strong>：傳統工藝守護者，「Amarone之父」 | <strong>位置</strong>：Negrar, Valpolicella Classico<br><strong>哲學</strong>：完全手工、拒絕現代化、超長陳年才發售（10年+）</p><p style='margin:0;padding:12px;background:#f9e79f;border-radius:6px;line-height:1.7;font-size:.9rem'><strong>代表作</strong>：Amarone Classico（發售前已陳年10+年極稀有，€250-€500+）、Recioto（傳統甜紅酒典範，€150-€300）⚠️ Giuseppe於2012年辭世，家族繼承遺志，產量極少價格持續上漲</p></div><div style='display:grid;grid-template-columns:repeat(3,1fr);gap:12px'><div style='background:#ebf5fb;padding:12px;border-radius:8px;border-top:3px solid #3498db'><h5 style='margin:0 0 8px;color:#3498db;font-size:1rem'>Allegrini</h5><p style='margin:0;font-size:.85rem;line-height:1.6'>現代優雅派，單一園系列國際知名度高，La Poja（100% Corvina），€30-€150</p></div><div style='background:#fef9e7;padding:12px;border-radius:8px;border-top:3px solid #f39c12'><h5 style='margin:0 0 8px;color:#f39c12;font-size:1rem'>Tommasi</h5><p style='margin:0;font-size:.85rem;line-height:1.6'>穩定高品質，家族經營性價比標竿，Amarone Classico，€40-€80</p></div><div style='background:#f4ecf7;padding:12px;border-radius:8px;border-top:3px solid #9b59b6'><h5 style='margin:0 0 8px;color:#9b59b6;font-size:1rem'>Masi</h5><p style='margin:0;font-size:.85rem;line-height:1.6'>Ripasso技術發明者，實驗創新多樣產品線，Costasera Amarone + Campofiorin Ripasso，€25-€100</p></div></div></div></div><div style='background:#fff;padding:20px;border-radius:12px;box-shadow:0 4px 15px rgba(0,0,0,.1);margin-bottom:20px'><h3 style='margin:0 0 15px;color:#16a085;border-bottom:3px solid #16a085;padding-bottom:8px'>🌟 Soave名莊</h3><div style='display:grid;grid-template-columns:repeat(3,1fr);gap:15px'><div style='background:linear-gradient(145deg,#e8f8f5,#fff);padding:15px;border-radius:12px;border-top:5px solid #16a085'><h4 style='margin:0 0 10px;color:#16a085;font-size:1.05rem'>Pieropan</h4><p style='margin:0 0 10px;font-size:.9rem;line-height:1.6'>Soave品質標竿，單一園專家老藤Garganega</p><p style='margin:0;padding:10px;background:#d1f2eb;border-radius:6px;font-size:.85rem;line-height:1.6'><strong>La Rocca</strong>（頂級單一園陳年20+年，€30-€50）<br><strong>Calvarino</strong>（礦物感驚人，€25-€40）</p></div><div style='background:linear-gradient(145deg,#e8f6f3,#fff);padding:15px;border-radius:12px;border-top:5px solid #1abc9c'><h4 style='margin:0 0 10px;color:#1abc9c;font-size:1.05rem'>Gini</h4><p style='margin:0 0 10px;font-size:.9rem;line-height:1.6'>老藤專家，有80+年老藤極致純淨</p><p style='margin:0;padding:10px;background:#d5f4e6;border-radius:6px;font-size:.85rem;line-height:1.6'><strong>Contrada Salvarenza Vecchie Vigne</strong>（老藤精華深度驚人，€35-€55）<br><strong>La Frosca</strong>（橡木桶陳年複雜度高，€25-€40）</p></div><div style='background:linear-gradient(145deg,#e0f2f1,#fff);padding:15px;border-radius:12px;border-top:5px solid #00897b'><h4 style='margin:0 0 10px;color:#00897b;font-size:1.05rem'>Inama</h4><p style='margin:0 0 10px;font-size:.9rem;line-height:1.6'>火山土壤大師，強調風土表達</p><p style='margin:0;padding:10px;background:#b2dfdb;border-radius:6px;font-size:.85rem;line-height:1.6'><strong>Vigneti di Foscarino</strong>（火山岩單一園，€30-€50）<br><strong>Soave Classico</strong>（入門首選，€15-€25）</p></div></div></div><div style='background:#fff;padding:20px;border-radius:12px;box-shadow:0 4px 15px rgba(0,0,0,.1)'><h3 style='margin:0 0 15px;color:#27ae60;border-bottom:3px solid #27ae60;padding-bottom:8px'>🥂 Prosecco名莊</h3><div style='display:grid;grid-template-columns:repeat(3,1fr);gap:15px'><div style='background:linear-gradient(145deg,#f0fdf4,#fff);padding:15px;border-radius:12px;border-top:5px solid #f1c40f'><h4 style='margin:0 0 10px;color:#f39c12;font-size:1.05rem'>Bisol（Cartizze之王）</h4><p style='margin:0 0 10px;font-size:.9rem;line-height:1.6'>Cartizze最大地主之一</p><p style='margin:0;padding:10px;background:#fcf3cf;border-radius:8px;font-size:.85rem;line-height:1.6'><strong>Cartizze</strong>（頂級Prosecco，€30-€50）<br><strong>Crede Valdobbiadene Brut</strong>（性價比高，€15-€25）</p></div><div style='background:linear-gradient(145deg,#e8f8f5,#fff);padding:15px;border-radius:12px;border-top:5px solid #16a085'><h4 style='margin:0 0 10px;color:#16a085;font-size:1.05rem'>Nino Franco（歷史名家）</h4><p style='margin:0 0 10px;font-size:.9rem;line-height:1.6'>家族傳承四代，1919年創立</p><p style='margin:0;padding:10px;background:#d1f2eb;border-radius:8px;font-size:.85rem;line-height:1.6'><strong>Cartizze</strong>（優雅細膩風格，€30-€45）<br><strong>Primo Franco Rive Brut</strong>（單一村莊高品質，€18-€28）</p></div><div style='background:linear-gradient(145deg,#ebf5fb,#fff);padding:15px;border-radius:12px;border-top:5px solid #3498db'><h4 style='margin:0 0 10px;color:#3498db;font-size:1.05rem'>Ruggeri（優雅派）</h4><p style='margin:0 0 10px;font-size:.9rem;line-height:1.6'>強調礦物感和清新度</p><p style='margin:0;padding:10px;background:#d6eaf8;border-radius:8px;font-size:.85rem;line-height:1.6'><strong>Giall'Oro Cartizze</strong>（Cartizze優雅代表，€28-€42）<br><strong>Quartese Extra Dry</strong>（傳統略甜風格，€12-€18）</p></div></div><div style='margin-top:15px;padding:15px;background:linear-gradient(135deg,#d5f4e6,#a9dfbf);border-radius:8px;text-align:center'><p style='margin:0;font-weight:700'>💡 選購建議：入門選Masi/Tommasi（Amarone）或Ruggeri（Prosecco），進階選Allegrini/Pieropan，收藏選Dal Forno/Quintarelli</p></div></div></section><section class='slide'><h2>📊 風格對比</h2><div class='comparison-table'><table><tr><th>酒款</th><th>顏色</th><th>甜度</th><th>酒精度</th><th>價格</th><th>陳年潛力</th></tr><tr><td><strong>Prosecco</strong></td><td>淡黃色</td><td>Dry-Extra Dry</td><td>10.5-12%</td><td>$-$$</td><td>1-3 年</td></tr><tr><td><strong>Soave Classico</strong></td><td>淡黃綠</td><td>不甜</td><td>11.5-13%</td><td>$$</td><td>3-8 年</td></tr><tr><td><strong>Valpolicella</strong></td><td>寶石紅</td><td>不甜</td><td>11-12.5%</td><td>$-$$</td><td>2-5 年</td></tr><tr><td><strong>Ripasso</strong></td><td>深紅</td><td>不甜</td><td>13-14%</td><td>$$-$$$</td><td>5-10 年</td></tr><tr><td><strong>Amarone</strong></td><td>深紅褐</td><td>Nearly Dry</td><td>15-17%</td><td>$$$-$$$$</td><td>10-30 年</td></tr></table></div></section><section class='slide'><h2>🎯 購買建議</h2><div class='buying-guide'><div class='guide-card entry'><h3>🌱 入門級 ($-$$)</h3><ul><li>Prosecco DOC</li><li>Valpolicella DOC</li><li>Soave DOC</li></ul><p class='guide-tip'>日常飲用，物超所值</p></div><div class='guide-card mid'><h3>🍷 進階級 ($$-$$$)</h3><ul><li>Prosecco Superiore DOCG</li><li>Soave Classico DOCG</li><li>Valpolicella Ripasso</li></ul><p class='guide-tip'>品質躍升，適合宴客</p></div><div class='guide-card premium'><h3>💎 收藏級 ($$$-$$$$)</h3><ul><li>Amarone della Valpolicella DOCG</li><li>Recioto della Valpolicella DOCG</li><li>頂級 Soave Riserva</li></ul><p class='guide-tip'>特殊場合，陳年佳釀</p></div></div></section><section class='slide'><h2>🎓 重點回顧</h2><div class='key-points'><div class='point'>✓ Veneto 是義大利產量第二大的產區，擁有14個DOCG和14個DOC</div><div class='point'>✓ 威尼斯共和國時期成就葡萄酒貿易黃金時代，Prosecco丘陵2019年列入UNESCO世界遺產</div><div class='point'>✓ 三大地理區：東部Prosecco丘陵（涼爽）、中西部Valpolicella/Soave（溫和）、南部Po河平原（大量生產）</div><div class='point'>✓ Corvina厚皮高酸適合Appassimento風乾，Garganega老藤展現驚人深度，Glera成就Prosecco清新風格</div><div class='point'>✓ Appassimento風乾工藝：3-4個月失水30-40%，濃縮糖分和風味，Amarone酒精15-17%陳年10-30年</div><div class='point'>✓ Prosecco金字塔：Cartizze（107ha Grand Cru）→ Conegliano Valdobbiadene DOCG → Asolo DOCG → Prosecco DOC</div><div class='point'>✓ Prosecco使用Charmat槽中二次發酵保持清新果香，2010年代銷量超越Champagne成為世界第一氣泡酒</div><div class='point'>✓ 頂級酒莊：Dal Forno Romano & Quintarelli（Amarone傳奇）、Pieropan & Gini（Soave標竿）、Bisol & Nino Franco（Prosecco名家）</div><div class='point'>✓ 風格多樣性極致：從清爽Prosecco（10.5-12%）到濃郁Amarone（15-17%），從入門€6到收藏級€600+</div></div></section></div><style>.region-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.stat-box{background:#fff;padding:25px;border-radius:12px;border-top:4px solid #16a085;text-align:center;display:flex;flex-direction:column;align-items:center;gap:12px}.stat-icon{font-size:2.5rem}.stat-number{font-size:1.4rem;font-weight:700;color:#2c3e50}.stat-desc{font-size:.9rem;color:#7f8c8d}.wine-showcase{display:grid;gap:20px}.showcase-item{background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 4px 15px rgba(0,0,0,.1)}.showcase-header{padding:20px;color:#fff;display:flex;justify-content:space-between;align-items:center}.showcase-item.prosecco .showcase-header{background:linear-gradient(135deg,#f39c12,#f1c40f)}.showcase-item.amarone .showcase-header{background:linear-gradient(135deg,#8e44ad,#9b59b6)}.showcase-item.soave .showcase-header{background:linear-gradient(135deg,#16a085,#1abc9c)}.showcase-header h3{margin:0;font-size:1.4rem}.wine-type{background:rgba(255,255,255,.3);padding:5px 15px;border-radius:20px;font-size:.85rem;font-weight:600}.showcase-body{padding:25px}.showcase-body p{margin:8px 0;line-height:1.8}.showcase-body strong{color:#2c3e50}.process-flow{display:flex;align-items:center;justify-content:center;margin:30px 0;flex-wrap:wrap}.process-step{background:#f8f9fa;padding:20px;border-radius:12px;text-align:center;min-width:150px}.step-number{width:45px;height:45px;background:#16a085;color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.3rem;font-weight:700;margin:0 auto 12px}.step-content h4{margin:8px 0;color:#2c3e50;font-size:1.1rem}.step-content p{margin:5px 0;font-size:.9rem;color:#555;line-height:1.5}.process-arrow{font-size:2rem;color:#16a085;font-weight:700;padding:0 15px}.comparison-table table{width:100%;border-collapse:collapse;font-size:.95rem}.comparison-table th{background:#16a085;color:#fff;padding:12px;text-align:left}.comparison-table td{padding:12px;border-bottom:1px solid #e0e0e0}.comparison-table tr:hover{background:#f8f9fa}.comparison-table strong{color:#16a085}.buying-guide{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.guide-card{padding:25px;border-radius:12px;border-top:5px solid}.guide-card.entry{background:linear-gradient(145deg,#e8f5e9,#fff);border-color:#4caf50}.guide-card.mid{background:linear-gradient(145deg,#fff3e0,#fff);border-color:#ff9800}.guide-card.premium{background:linear-gradient(145deg,#f3e5f5,#fff);border-color:#9c27b0}.guide-card h3{margin:0 0 15px;color:#2c3e50}.guide-card ul{margin:10px 0;padding-left:20px;line-height:2}.guide-tip{margin-top:15px;padding-top:15px;border-top:2px solid rgba(0,0,0,.1);font-style:italic;color:#555;font-weight:600}.key-points{display:grid;gap:10px}.point{background:linear-gradient(90deg,#e0f2f1,transparent);padding:16px 22px;border-left:4px solid #16a085;font-size:1.05rem;font-weight:600;color:#2c3e50}.map-slide-container{display:grid;grid-template-columns:2fr 1fr;gap:30px;height:calc(100vh - 200px);min-height:500px;padding:20px}.veneto-region-map{width:100%;height:100%;border-radius:12px;overflow:hidden;box-shadow:0 8px 30px rgba(0,0,0,.3);background:#1a1a2e}.map-legend{background:rgba(26,26,46,.92);backdrop-filter:blur(10px);border-radius:12px;padding:25px;border:1px solid rgba(255,255,255,.2);height:fit-content;box-shadow:0 4px 20px rgba(0,0,0,.3)}</style>",
