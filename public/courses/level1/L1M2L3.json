{
  "lessonId": "L1M2L3",
  "title": "Veneto 威尼托 - 水都風情",
  "content": "<div class='slides'><section class='slide-cover' style='background:linear-gradient(135deg,#16a085 0%,#1abc9c 100%)'><h1>🍷 Veneto 威尼托</h1><p class='subtitle'>從 Prosecco 到 Amarone 的多樣世界</p></section><section class='slide'><h2>🗺️ Veneto 產區地圖</h2><div class='map-slide-container'><div id='veneto-map' class='veneto-region-map'></div><div class='map-legend' style='background:linear-gradient(135deg,rgba(26,26,46,0.95),rgba(26,26,46,0.98));backdrop-filter:blur(15px);border-radius:16px;padding:30px;border:1px solid rgba(255,255,255,0.25);box-shadow:0 8px 32px rgba(0,0,0,0.4)'><h3 style='margin:0 0 25px;color:#fff;font-size:1.4rem;font-weight:700;text-align:center;border-bottom:3px solid rgba(22,160,133,0.7);padding-bottom:12px'>圖例說明</h3><div style='margin-bottom:25px;padding-bottom:20px;border-bottom:1px solid rgba(255,255,255,0.15)'><h4 style='margin:0 0 12px;color:rgba(255,255,255,0.9);font-size:1.1rem;font-weight:600'>🌍 大區邊界</h4><div style='display:flex;align-items:center;gap:12px;padding:8px 0'><div style='width:30px;height:20px;background:rgba(22,160,133,0.15);border:3px solid #f39c12;border-radius:4px;flex-shrink:0'></div><span style='color:rgba(255,255,255,0.95);font-size:1.05rem;font-weight:500'>威尼托大區範圍</span></div></div><div style='margin-bottom:25px;padding-bottom:20px;border-bottom:1px solid rgba(255,255,255,0.15)'><h4 style='margin:0 0 12px;color:rgba(255,255,255,0.9);font-size:1.1rem;font-weight:600'>🍷 產區分級（DOCG 邊界）</h4><div style='display:flex;flex-direction:column;gap:10px'><div style='display:flex;align-items:center;gap:12px'><div style='width:30px;height:20px;background:#c0392b;border-radius:4px;flex-shrink:0;box-shadow:0 0 10px rgba(192,57,43,0.4)'></div><span style='color:rgba(255,255,255,0.95);font-size:1.05rem;font-weight:500'>S級 DOCG - Amarone, Recioto Valpolicella</span></div><div style='display:flex;align-items:center;gap:12px'><div style='width:30px;height:20px;background:#27ae60;border-radius:4px;flex-shrink:0;box-shadow:0 0 10px rgba(39,174,96,0.4)'></div><span style='color:rgba(255,255,255,0.95);font-size:1.05rem;font-weight:500'>A級 DOCG - Prosecco 系列, Soave 系列</span></div><div style='display:flex;align-items:center;gap:12px'><div style='width:30px;height:20px;background:#3498db;border-radius:4px;flex-shrink:0;box-shadow:0 0 10px rgba(52,152,219,0.4)'></div><span style='color:rgba(255,255,255,0.95);font-size:1.05rem;font-weight:500'>B級 DOCG - Bardolino, Lison, 其他產區</span></div><div style='display:flex;align-items:center;gap:12px'><div style='width:16px;height:16px;background:#f39c12;border-radius:50%;flex-shrink:0;box-shadow:0 0 8px rgba(243,156,18,0.6)'></div><span style='color:rgba(255,255,255,0.95);font-size:1.05rem;font-weight:500'>重要城市</span></div></div></div><div style='background:rgba(102,126,234,0.15);border-radius:10px;padding:18px;margin-top:5px;border:1px solid rgba(102,126,234,0.3)'><p style='margin:0 0 10px;color:#fff;font-weight:700;font-size:1.05rem'>💡 地圖操作提示：</p><ul style='margin:0;padding-left:20px;color:rgba(255,255,255,0.95);line-height:1.8;list-style:none'><li style='padding-left:0;margin:5px 0;font-size:1rem;font-weight:500'>🖱️ 滑鼠滾輪縮放地圖</li><li style='padding-left:0;margin:5px 0;font-size:1rem;font-weight:500'>🖐️ 拖曳移動視角</li><li style='padding-left:0;margin:5px 0;font-size:1rem;font-weight:500'>📍 點擊區域查看產區詳情</li></ul></div></div></div></section><section class='slide'><h2>📍 產區概況</h2><div class='region-stats'><div class='stat-box'><div class='stat-icon'>📍</div><div class='stat-content'><div class='stat-number'>義大利東北部</div><div class='stat-desc'>威尼斯大區</div></div></div><div class='stat-box'><div class='stat-icon'>🌾</div><div class='stat-content'><div class='stat-number'>~80,000 ha</div><div class='stat-desc'>義大利第二大產區</div></div></div><div class='stat-box'><div class='stat-icon'>🏆</div><div class='stat-content'><div class='stat-number'>14 DOCG + 14 DOC</div><div class='stat-desc'>法定產區</div></div></div><div class='stat-box'><div class='stat-icon'>🍾</div><div class='stat-content'><div class='stat-number'>#1</div><div class='stat-desc'>義大利最大 Prosecco 產區</div></div></div></div></section><section class='slide'><h2>✨ 三大明星酒款</h2><div class='wine-showcase'><div class='showcase-item prosecco'><div class='showcase-header'><h3>🥂 Prosecco</h3><span class='wine-type'>氣泡酒</span></div><div class='showcase-body'><p><strong>品種：</strong>Glera 85% 以上</p><p><strong>產區：</strong>Prosecco DOC / Valdobbiadene DOCG</p><p><strong>風格：</strong>清新、果香、氣泡細膩</p><p><strong>價格：</strong>$-$$</p><p><strong>搭配：</strong>開胃菜、海鮮、brunch</p></div></div><div class='showcase-item amarone'><div class='showcase-header'><h3>🍷 Amarone della Valpolicella</h3><span class='wine-type'>DOCG 紅酒</span></div><div class='showcase-body'><p><strong>品種：</strong>Corvina, Rondinella, Molinara</p><p><strong>工藝：</strong>風乾葡萄（Appassimento）</p><p><strong>風格：</strong>濃郁、甜美、酒精度高（15-17%）</p><p><strong>價格：</strong>$$$-$$$$</p><p><strong>搭配：</strong>燉肉、野味、陳年起司</p></div></div><div class='showcase-item soave'><div class='showcase-header'><h3>🌟 Soave</h3><span class='wine-type'>DOCG 白酒</span></div><div class='showcase-body'><p><strong>品種：</strong>Garganega 70% 以上</p><p><strong>產區：</strong>Soave Classico DOCG</p><p><strong>風格：</strong>清爽、礦物感、杏仁香</p><p><strong>價格：</strong>$$</p><p><strong>搭配：</strong>白肉、淡水魚、沙拉</p></div></div></div></section><section class='slide'><h2>🍇 Appassimento 風乾工藝</h2><div class='process-flow'><div class='process-step'><div class='step-number'>1</div><div class='step-content'><h4>🍇 採收</h4><p>9-10 月人工採摘</p><p>精選最健康的串</p></div></div><div class='process-arrow'>→</div><div class='process-step'><div class='step-number'>2</div><div class='step-content'><h4>🌬️ 風乾</h4><p>通風棚架自然乾燥</p><p>3-4 個月（至隔年1-2月）</p></div></div><div class='process-arrow'>→</div><div class='process-step'><div class='step-number'>3</div><div class='step-content'><h4>📉 濃縮</h4><p>失去 30-40% 水分</p><p>糖分和風味濃縮</p></div></div><div class='process-arrow'>→</div><div class='process-step'><div class='step-number'>4</div><div class='step-content'><h4>🍷 釀造</h4><p>緩慢發酵</p><p>橡木桶陳年 2-6 年</p></div></div></div><div class='highlight-box'><p><strong>💡 Appassimento 造就三種酒:</strong></p><ul><li><strong>Amarone</strong> - 完全發酵成不甜</li><li><strong>Recioto</strong> - 保留殘糖的甜紅酒</li><li><strong>Ripasso</strong> - 用 Amarone 酒渣二次發酵</li></ul></div></section><section class='slide'><h2>📊 風格對比</h2><div class='comparison-table'><table><tr><th>酒款</th><th>顏色</th><th>甜度</th><th>酒精度</th><th>價格</th><th>陳年潛力</th></tr><tr><td><strong>Prosecco</strong></td><td>淡黃色</td><td>Dry-Extra Dry</td><td>10.5-12%</td><td>$-$$</td><td>1-3 年</td></tr><tr><td><strong>Soave Classico</strong></td><td>淡黃綠</td><td>不甜</td><td>11.5-13%</td><td>$$</td><td>3-8 年</td></tr><tr><td><strong>Valpolicella</strong></td><td>寶石紅</td><td>不甜</td><td>11-12.5%</td><td>$-$$</td><td>2-5 年</td></tr><tr><td><strong>Ripasso</strong></td><td>深紅</td><td>不甜</td><td>13-14%</td><td>$$-$$$</td><td>5-10 年</td></tr><tr><td><strong>Amarone</strong></td><td>深紅褐</td><td>Nearly Dry</td><td>15-17%</td><td>$$$-$$$$</td><td>10-30 年</td></tr></table></div></section><section class='slide'><h2>🎯 購買建議</h2><div class='buying-guide'><div class='guide-card entry'><h3>🌱 入門級 ($-$$)</h3><ul><li>Prosecco DOC</li><li>Valpolicella DOC</li><li>Soave DOC</li></ul><p class='guide-tip'>日常飲用，物超所值</p></div><div class='guide-card mid'><h3>🍷 進階級 ($$-$$$)</h3><ul><li>Prosecco Superiore DOCG</li><li>Soave Classico DOCG</li><li>Valpolicella Ripasso</li></ul><p class='guide-tip'>品質躍升，適合宴客</p></div><div class='guide-card premium'><h3>💎 收藏級 ($$$-$$$$)</h3><ul><li>Amarone della Valpolicella DOCG</li><li>Recioto della Valpolicella DOCG</li><li>頂級 Soave Riserva</li></ul><p class='guide-tip'>特殊場合，陳年佳釀</p></div></div></section><section class='slide'><h2>🎓 重點回顧</h2><div class='key-points'><div class='point'>✓ Veneto 是義大利產量第二大的產區</div><div class='point'>✓ Prosecco 是世界最暢銷的氣泡酒之一</div><div class='point'>✓ Amarone 的 Appassimento 工藝獨一無二</div><div class='point'>✓ 從清爽到濃郁，Veneto 風格極度多樣</div></div></section></div><style>.region-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.stat-box{background:#fff;padding:25px;border-radius:12px;border-top:4px solid #16a085;text-align:center;display:flex;flex-direction:column;align-items:center;gap:12px}.stat-icon{font-size:2.5rem}.stat-number{font-size:1.4rem;font-weight:700;color:#2c3e50}.stat-desc{font-size:.9rem;color:#7f8c8d}.wine-showcase{display:grid;gap:20px}.showcase-item{background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 4px 15px rgba(0,0,0,.1)}.showcase-header{padding:20px;color:#fff;display:flex;justify-content:space-between;align-items:center}.showcase-item.prosecco .showcase-header{background:linear-gradient(135deg,#f39c12,#f1c40f)}.showcase-item.amarone .showcase-header{background:linear-gradient(135deg,#8e44ad,#9b59b6)}.showcase-item.soave .showcase-header{background:linear-gradient(135deg,#16a085,#1abc9c)}.showcase-header h3{margin:0;font-size:1.4rem}.wine-type{background:rgba(255,255,255,.3);padding:5px 15px;border-radius:20px;font-size:.85rem;font-weight:600}.showcase-body{padding:25px}.showcase-body p{margin:8px 0;line-height:1.8}.showcase-body strong{color:#2c3e50}.process-flow{display:flex;align-items:center;justify-content:center;margin:30px 0;flex-wrap:wrap}.process-step{background:#f8f9fa;padding:20px;border-radius:12px;text-align:center;min-width:150px}.step-number{width:45px;height:45px;background:#16a085;color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.3rem;font-weight:700;margin:0 auto 12px}.step-content h4{margin:8px 0;color:#2c3e50;font-size:1.1rem}.step-content p{margin:5px 0;font-size:.9rem;color:#555;line-height:1.5}.process-arrow{font-size:2rem;color:#16a085;font-weight:700;padding:0 15px}.comparison-table table{width:100%;border-collapse:collapse;font-size:.95rem}.comparison-table th{background:#16a085;color:#fff;padding:12px;text-align:left}.comparison-table td{padding:12px;border-bottom:1px solid #e0e0e0}.comparison-table tr:hover{background:#f8f9fa}.comparison-table strong{color:#16a085}.buying-guide{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.guide-card{padding:25px;border-radius:12px;border-top:5px solid}.guide-card.entry{background:linear-gradient(145deg,#e8f5e9,#fff);border-color:#4caf50}.guide-card.mid{background:linear-gradient(145deg,#fff3e0,#fff);border-color:#ff9800}.guide-card.premium{background:linear-gradient(145deg,#f3e5f5,#fff);border-color:#9c27b0}.guide-card h3{margin:0 0 15px;color:#2c3e50}.guide-card ul{margin:10px 0;padding-left:20px;line-height:2}.guide-tip{margin-top:15px;padding-top:15px;border-top:2px solid rgba(0,0,0,.1);font-style:italic;color:#555;font-weight:600}.key-points{display:grid;gap:10px}.point{background:linear-gradient(90deg,#e0f2f1,transparent);padding:16px 22px;border-left:4px solid #16a085;font-size:1.05rem;font-weight:600;color:#2c3e50}.map-slide-container{display:grid;grid-template-columns:2fr 1fr;gap:30px;height:calc(100vh - 200px);min-height:500px;padding:20px}.veneto-region-map{width:100%;height:100%;border-radius:12px;overflow:hidden;box-shadow:0 8px 30px rgba(0,0,0,.3);background:#1a1a2e}.map-legend{background:rgba(26,26,46,.92);backdrop-filter:blur(10px);border-radius:12px;padding:25px;border:1px solid rgba(255,255,255,.2);height:fit-content;box-shadow:0 4px 20px rgba(0,0,0,.3)}</style>",
  "quiz": [
    {
      "question": "Prosecco 主要使用哪個葡萄品種釀造？",
      "options": [
        "Chardonnay",
        "Glera",
        "Pinot Grigio",
        "Garganega"
      ],
      "answer": 1,
      "explanation": "Prosecco 必須使用至少 85% 的 Glera 葡萄釀造。"
    },
    {
      "question": "Amarone 的 Appassimento 工藝是指？",
      "options": [
        "冰凍葡萄",
        "風乾葡萄",
        "貴腐葡萄",
        "晚摘葡萄"
      ],
      "answer": 1,
      "explanation": "Appassimento 是將葡萄在通風棚架上風乾 3-4 個月，使糖分和風味濃縮。"
    },
    {
      "question": "Amarone 的典型酒精度是？",
      "options": [
        "10-12%",
        "12-14%",
        "15-17%",
        "18-20%"
      ],
      "answer": 2,
      "explanation": "由於風乾工藝使糖分濃縮，Amarone 的酒精度通常達到 15-17%。"
    },
    {
      "question": "Soave 主要使用哪個白葡萄品種？",
      "options": [
        "Garganega",
        "Trebbiano",
        "Verdicchio",
        "Cortese"
      ],
      "answer": 0,
      "explanation": "Soave 必須使用至少 70% 的 Garganega 葡萄釀造。"
    }
  ]
}
