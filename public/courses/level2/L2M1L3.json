    {
      "question": "Cinque Terre 五漁村的主要白葡萄品種是？",
      "options": [
        "Vermentino",
        "Bosco",
        "Pinot Grigio",
        "Trebbiano"
      ],
      "answer": 1,
      "explanation": "Bosco 是 Cinque Terre DOC 的主要品種，必須占 60% 以上，適應陡坡環境。"
