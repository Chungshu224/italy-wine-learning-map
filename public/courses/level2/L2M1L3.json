er-color:#3498db}.wine-card.sweet{border-color:#f39c12}.wine-card h4{margin:0 0 15px;color:#2c3e50;font-size:1.2rem}.wine-card p{margin:8px 0;line-height:1.6}.wine-card strong{color:#3498db}.ct-fact{background:linear-gradient(135deg,#fef5e7,#fff);padding:15px 25px;border-radius:10px;border-left:5px solid #e67e22;text-align:center}.ct-fact p{margin:0;line-height:1.8;color:#2c3e50}.maritime-influence{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.influence-card{background:#fff;padding:25px;border-radius:12px;text-align:center;box-shadow:0 3px 10px rgba(0,0,0,.1);border-top:4px solid #3498db}.influence-icon{font-size:3rem;margin-bottom:12px}.influence-card h4{margin:10px 0;color:#3498db;font-size:1.1rem}.influence-card p{margin:0;color:#555;line-height:1.7}.other-docs{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.doc-card{background:#fff;padding:25px;border-radius:12px;box-shadow:0 4px 15px rgba(0,0,0,.1);border-top:5px solid #3498db}.doc-card h4{margin:0 0 8px;color:#3498db;font-size:1.2rem}.doc-location{margin:0 0 15px;color:#7f8c8d;font-style:italic}.doc-info p{margin:10px 0;line-height:1.6}.doc-info strong{color:#2c3e50}.food-culture{background:#fff;padding:30px;border-radius:12px;box- shadow:0 4px 15px rgba(0,0,0,.1)}.culture-intro{text-align:center;margin-bottom:25px;padding:20px;background:linear-gradient(135deg,#e8f5e9,#c8e6c9);border-radius:10px}.culture-intro h3{margin:0 0 12px;color:#27ae60;font-size:1.5rem}.culture-intro p{margin:0;font-size:1.1rem;line-height:1.8;color:#2c3e50}.food-pairing{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.pairing-item{background:linear-gradient(145deg,#f8f9fa,#fff);padding:20px;border-radius:10px;border-left:5px solid #27ae60}.pairing-item h4{margin:0 0 10px;color:#27ae60;font-size:1.1rem}.pairing-item p{margin:0;line-height:1.6;color:#555}.pairing-item strong{color:#2c3e50}.key-points{display:grid;gap:10px}.point{background:linear-gradient(90deg,#d6eaf8,transparent);padding:16px 22px;border-left:4px solid #3498db;font-size:1.05rem;font-weight:600;color:#2c3e50}</style>",
  "quiz": [
