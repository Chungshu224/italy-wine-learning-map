:0 0 12px;color:#f39c12;font-size:1.4rem}.greco-intro p{margin:0;font-size:1.1rem;line-height:1.8;color:#2c3e50}.greco-details{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.detail-card{background:linear-gradient(145deg,#f8f9fa,#fff);padding:25px;border-radius:10px;border-top:5px solid #f39c12}.detail-card h4{margin:0 0 15px;color:#f39c12;font-size:1.1rem}.detail-card p{margin:10px 0;line-height:1.7}.detail-card ul{margin:10px 0;padding-left:25px;line-height:1.9}.detail-card strong{color:#2c3e50}.other-docs{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.doc-card{background:#fff;padding:25px;border-radius:12px;box-shadow:0 4px 15px rgba(0,0,0,.1);border-top:6px solid #16a085}.doc-card h3{margin:0 0 15px;color:#16a085;font-size:1.2rem}.doc-info p{margin:10px 0;line-height:1.7}.doc-info strong{color:#2c3e50}.calabria-cuisine{background:#fff;padding:30px;border-radius:12px;box-shadow:0 4px 15px rgba(0,0,0,.1)}.cuisine-intro{text-align:center;padding:20px;background:linear-gradient(135deg,#fff3cd,#ffe69c);border-radius:10px;margin-bottom:25px}.cuisine-intro h3{margin:0 0 12px;color:#d35400;font-size:1.3rem}.cuisine-intro p{margin:0;font-size:1.1rem;line-height:1.8;color:#2c3e50}.food-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}.food-card{background:linear-gradient(145deg,#f8f9fa,#fff);padding:25px;border-radius:12px;border-top:5px solid #d35400}.food-card h4{margin:0 0 8px;color:#d35400;font-size:1.1rem}.dish-desc{color:#7f8c8d;font-style:italic;margin:0 0 15px;font-size:.95rem}.food-card p{margin:10px 0;line-height:1.7}.food-card ul{margin:5px 0;padding-left:25px;line-height:1.9}.food-card strong{color:#2c3e50}.key-points{display:grid;gap:10px}.point{background:linear-gradient(90deg,#d1f2eb,transparent);padding:16px 22px;border-left:4px solid #16a085;font-size:1.05rem;font-weight:600;color:#2c3e50}</style>",
  "quiz": [
    {
      "question": "Cirò DOC 的傳說與什麼有關？",
      "options": [
        "羅馬皇帝",
        "古希臘奧運選手",
        "中世紀騎士",
        "文藝復興藝術家"
      ],
      "answer": 1,
      "explanation": "傳說古希臘奧運選手在比賽後會飲用 Cirò 葡萄酒慶祝，當時稱為 Cremissa。"
    },
    {
      "question": "Gaglioppo 為什麼被稱為「南義的 Pinot Noir」？",
      "options": [
        "產量相同",
        "顏色較淡、單寧柔順、風味細膩",
        "價格相同",
        "都產自法國"
      ],
      "answer": 1,
      "explanation": "Gaglioppo 與 Pinot Noir 類似，顏色相對較淡、單寧柔順、風味細膩，因此被稱為「南義的 Pinot Noir」。"
    },
    {
      "question": "Greco di Bianco DOC 的酒精度通常是？",
      "options": [
        "10-12%",
        "12-14%",
        "14-16%",
        "17%+"
      ],
      "answer": 3,
      "explanation": "Greco di Bianco 是甜白酒，使用風乾葡萄釀造，酒精度極高（17%+），是義大利最甜、最濃郁的甜白酒之一。"
    },
    {
      "question": "'Nduja 是什麼？",
      "options": [
        "一種葡萄品種",
        "Calabria 超辣抹醬香腸",
        "一種甜點",
        "一個 DOC 產區"
      ],
      "answer": 1,
      "explanation": "'Nduja 是 Calabria 的超辣抹醬香腸，主要成分是豬肉和大量辣椒，可塗麵包食用，搭配 Cirò Rosso 完美。"
    },
    {
      "question": "Calabria被稱為什麼？",
      "options": [
        "義大利的膝蓋",
        "義大利的腳尖",
        "義大利的腳踝",
        "義大利的心臟"
      ],
      "answer": 1,
      "explanation": "Calabria位於義大利半島最南端（「靴子」的腳尖部分），夾在Ionian海和Tyrrhenian海之間。"
    }
  ]
