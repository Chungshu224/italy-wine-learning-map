4px 12px rgba(0,0,0,.08)}.pasta-card h4{margin:0 0 15px;color:#d35400;font-size:1.15rem}.dish-details p{margin:10px 0;line-height:1.7}.dish-details strong{color:#2c3e50}.dish-details ul{margin:10px 0;padding-left:25px;line-height:1.9}.key-points{display:grid;gap:10px}.point{background:linear-gradient(90deg,#fef5e7,transparent);padding:16px 22px;border-left:4px solid #f39c12;font-size:1.05rem;font-weight:600;color:#2c3e50}</style>",
